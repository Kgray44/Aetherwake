import test from 'node:test';import assert from 'node:assert/strict';import {mkdtempSync,rmSync,realpathSync} from 'node:fs';import {tmpdir} from 'node:os';import path from 'node:path';
import {DatabaseSync} from 'node:sqlite';
import {BOUNDS,sha,readSealedFixtures,preparePilot,buildTurn,evaluateExpression,grade,summarize,createPilotRunner,describePilotRun,type RunAuthorization,type RunAuthority,type RunBinding,type PreparedArm,type Observation} from './benchmark.mts';
import type {TurnInput,TurnResult} from '../../../prototypes/openai-provider/contracts.mts';
const arg=(index:number)=>({op:'arg',index}),constant=(value:number)=>({op:'const',value}),op=(name:string,...args:unknown[])=>({op:name,args});
const expressions={
 'interval-overlap':op('max',constant(0),op('sub',op('min',arg(1),arg(3)),op('max',arg(0),arg(2)))),
 'capped-retry':op('min',arg(2),op('mul',arg(1),op('pow',constant(2),arg(0)))),
};
function unitArm(id:'interval-overlap'|'capped-retry'):PreparedArm{return {fixtureId:id,functionName:id==='interval-overlap'?'overlapLength':'retryDelay',sourceIds:['source:code','source:spec']} as PreparedArm;}
const answer=(arm:PreparedArm,expression:unknown)=>JSON.stringify({fixtureId:arm.fixtureId,functionName:arm.functionName,expression,sourceIds:['source:code']});
const authorization=(id:string):RunAuthorization=>({id,candidateHead:'1'.repeat(40),candidateTree:'2'.repeat(40)});
/** Offline host fixture, with an actual SQLite durable consumption transaction.
 * This is test authorization, not a production credential/dispatch adapter. */
function authorityAt(file:string){
 const db=new DatabaseSync(file);db.exec('CREATE TABLE IF NOT EXISTS approvals(id TEXT PRIMARY KEY,digest TEXT NOT NULL,claimed INTEGER NOT NULL DEFAULT 0)');
 return {approve(binding:RunBinding){db.prepare('INSERT INTO approvals(id,digest) VALUES(?,?)').run(binding.authorization.id,sha(JSON.stringify(binding)));},close:()=>db.close(),
  claim:async(binding:RunBinding)=>{db.exec('BEGIN IMMEDIATE');try{const row=db.prepare('SELECT digest,claimed FROM approvals WHERE id=?').get(binding.authorization.id);assert(row,'benchmark_authorization_not_approved');assert.equal(row.claimed,0,'benchmark_authorization_already_consumed');assert.equal(row.digest,sha(JSON.stringify(binding)),'benchmark_authorization_binding_changed');assert.equal(db.prepare('UPDATE approvals SET claimed=1 WHERE id=? AND claimed=0').run(binding.authorization.id).changes,1);db.exec('COMMIT');return {authorizationId:binding.authorization.id,claimId:'sqlite-claim:'+binding.authorization.id,bindingDigest:String(row.digest)};}catch(error){db.exec('ROLLBACK');throw error;}}
 } satisfies RunAuthority&{approve(binding:RunBinding):void;close():void};
}
function completed(input:TurnInput):TurnResult{const parsed=JSON.parse(input.messages[0].content);return {providerId:'openai-api-vela',executionId:input.executionId,requestId:input.requestId,outcome:'completed',dispatched:true,cancellation:{requested:false,serverConfirmed:false},taskVerified:false,reportedModel:'gpt-6-luna',partialText:JSON.stringify({fixtureId:parsed.fixtureId,functionName:parsed.functionName,expression:expressions[parsed.fixtureId as keyof typeof expressions],sourceIds:[parsed.context.sources[0].citation.ref.id]})};}
test('fixture and independent held-out manifests match their fixed pre-model seal',()=>{const {publicData,heldOut,seal}=readSealedFixtures();assert.equal(publicData.cases.length,2);assert.equal(heldOut.cases.reduce((sum,item)=>sum+item.tests.length,0),17);assert.equal(seal.optimizerBaseline,'91fbf64f124aaab9789844ec56b65cf6f6f8279d');assert.equal(BOUNDS.model,'gpt-6-luna');assert.equal(BOUNDS.calls,4);});
test('actual Core canonical notes/retrieval and production compiler prepare exact bounded ABBA contexts without a provider',async t=>{
 const directory=mkdtempSync(path.join(tmpdir(),'aerynth-context-benchmark-'));let prepared:Awaited<ReturnType<typeof preparePilot>>|undefined;
 t.after(async()=>{await prepared?.close();assert.equal(path.dirname(directory),tmpdir());assert(path.basename(directory).startsWith('aerynth-context-benchmark-'));assert.equal(realpathSync(directory).toLowerCase(),path.resolve(directory).toLowerCase());rmSync(directory,{recursive:true,force:true});});
 prepared=await preparePilot(path.join(directory,'canonical.sqlite'));assert.deepEqual(prepared.arms.map(item=>item.arm),['scoped','declared-full','declared-full','scoped']);assert.equal(prepared.activity.providerRequests,0);assert.equal(prepared.activity.codexConnections,0);
 for(const id of ['interval-overlap','capped-retry']){const scoped:PreparedArm=prepared.arms.find(item=>item.fixtureId===id&&item.arm==='scoped')!,full:PreparedArm=prepared.arms.find(item=>item.fixtureId===id&&item.arm==='declared-full')!;
  assert.equal(scoped.context.manifest.retrieval,'searched');assert.equal(scoped.sourceIds.length,2);assert.equal(full.sourceIds.length,12);assert(scoped.context.manifest.sources.some(item=>item.ref.id===scoped.sourceIdsByPurpose.spec&&item.inclusion==='relevant'));assert.deepEqual(scoped.context.payload.criteria,full.context.payload.criteria);assert.equal(scoped.context.payload.taskObjective,full.context.payload.taskObjective);assert.deepEqual(scoped.context.payload.constraints,full.context.payload.constraints);assert(scoped.context.manifest.accounting.payloadBytes<full.context.manifest.accounting.payloadBytes);assert.equal(scoped.context.manifest.accounting.method,'utf8-byte-estimate');assert(Object.isFrozen(scoped.context.payload));
  for(const arm of [scoped,full]){prepared.validate(arm);const turn=buildTurn(arm,{id:'offline-synthetic',version:1},{executionId:'offline:'+id+':'+arm.arm,requestId:'request:'+id+':'+arm.arm}),body=JSON.parse(turn.body);assert(Buffer.byteLength(turn.body)<=BOUNDS.bodyBytes);assert.equal(body.model,'gpt-6-luna');assert.deepEqual(body.reasoning,{effort:'low'});assert.equal(body.max_output_tokens,1024);assert.equal(body.store,false);assert.equal(body.tools,undefined);assert.equal(body.previous_response_id,undefined);assert(!turn.body.includes('fixtures.held-out.json'));assert(!turn.body.includes('"expected":'));}
 }
 const configuration={id:'offline-fake-port',version:1},success=authorization('offline-success'),ledger=path.join(directory,'authorization.sqlite');let authority=authorityAt(ledger);
 try{
 authority.approve(describePilotRun(prepared,configuration,success));let dispatches=0;
 const port={turn:async(input:TurnInput,_signal:AbortSignal,firstText:()=>void)=>{dispatches++;firstText();return completed(input);}};
 const runner=createPilotRunner(prepared,port,configuration,success,authority);
 const result=await runner.run();assert.equal(dispatches,4);assert.equal(result.complete,true);assert.equal(result.summary!.tokenReduction,null,'missing provider usage cannot become token savings');assert.equal(result.summary!.arms[0].verified,2);assert.equal(result.summary!.arms[1].verified,2);await assert.rejects(runner.run(),/already_consumed/);assert.equal(dispatches,4);
 authority.close();authority=authorityAt(ledger);
 await assert.rejects(createPilotRunner(prepared,port,configuration,success,authority).run(),/already_consumed/,'a recreated runner and reopened durable host cannot reuse authorization');
 await assert.rejects(createPilotRunner(prepared,port,{...configuration,version:2},success,authority).run(),/already_consumed/,'changing the binding cannot reset the fixed consumed authorization ID');assert.equal(dispatches,4);
 let unknownDispatches=0;const unknownAuth=authorization('offline-unknown');authority.approve(describePilotRun(prepared,configuration,unknownAuth));const unknown=createPilotRunner(prepared,{turn:async input=>{unknownDispatches++;return {...completed(input),outcome:'unknown',reportedModel:undefined,partialText:''};}},configuration,unknownAuth,authority);const stopped=await unknown.run();assert.equal(unknownDispatches,1);assert.equal(stopped.complete,false);assert.equal(stopped.summary,null);await assert.rejects(unknown.run(),/already_consumed/);
 for(const field of ['providerId','executionId','requestId','dispatched'] as const){let calls=0;const auth=authorization('wrong-'+field);authority.approve(describePilotRun(prepared,configuration,auth));const failed=await createPilotRunner(prepared,{turn:async input=>{calls++;return {...completed(input),[field]:field==='dispatched'?false:field==='providerId'?'chatgpt-plan-responses':'wrong-identity'} as TurnResult;}},configuration,auth,authority).run();assert.equal(calls,1);assert.equal(failed.complete,false);assert.equal(failed.summary,null);assert.equal(failed.attempts,1);assert('failedPhase' in failed.rows[0]&&failed.rows[0].failedPhase==='result-provenance');}
 const mutatedInput=authorization('mutated-input');authority.approve(describePilotRun(prepared,configuration,mutatedInput));const mutated=await createPilotRunner(prepared,{turn:async input=>{Reflect.set(input,'executionId','changed-by-port');return completed(input);}},configuration,mutatedInput,authority).run();assert.equal(mutated.complete,false);assert.match(mutated.stopReason!,/benchmark_result_execution_mismatch/,'result identities are compared to the frozen approved slot, not a mutable transport input');
 const unapproved=authorization('not-approved');await assert.rejects(createPilotRunner(prepared,port,configuration,unapproved,authority).run(),/not_approved/);
 await assert.rejects(createPilotRunner(prepared,port,configuration,unapproved,undefined as unknown as RunAuthority).run(),/durable_benchmark_authority_required/);assert.equal(dispatches,4);
 const changedConfig={...configuration},configAuth=authorization('changed-config');authority.approve(describePilotRun(prepared,changedConfig,configAuth));
 await assert.rejects(createPilotRunner(prepared,port,changedConfig,configAuth,{claim:async binding=>{const claim=await authority.claim(binding);changedConfig.version++;return claim;}}).run(),/benchmark_binding_changed_after_claim/);assert.equal(dispatches,4);
 const badClaim=authorization('bad-claim');authority.approve(describePilotRun(prepared,configuration,badClaim));await assert.rejects(createPilotRunner(prepared,port,configuration,badClaim,{claim:async binding=>({...await authority.claim(binding),bindingDigest:'0'.repeat(64)})}).run(),/benchmark_claim_binding_mismatch/);assert.equal(dispatches,4);
 await assert.rejects(createPilotRunner(prepared,port,configuration,badClaim,authority).run(),/already_consumed/,'failed claim receipt validation does not restore a consumed authorization');
 const fixed=authorization('fixed-binding');authority.approve(describePilotRun(prepared,configuration,fixed));
 for(const change of [{authorization:{...fixed,candidateHead:'3'.repeat(40)},configuration},{authorization:{...fixed,candidateTree:'4'.repeat(40)},configuration},{authorization:fixed,configuration:{...configuration,version:2}}])await assert.rejects(createPilotRunner(prepared,port,change.configuration,change.authorization,authority).run(),/benchmark_authorization_binding_changed/);
 await assert.rejects(createPilotRunner({...prepared,sealDigest:'0'.repeat(64)},port,configuration,fixed,authority).run(),/benchmark_fixture_seal_changed/);assert.equal(dispatches,4);
 }finally{authority.close();}
 const current=prepared.arms[0];await prepared.archiveScopeForTest(current);assert.throws(()=>prepared!.validate(current),/mission_context_/u,'current authority/version must still hold at dispatch');
});
test('held-out behavioral verification accepts independently calculated repairs and rejects the original defects',()=>{for(const id of ['interval-overlap','capped-retry'] as const){const arm=unitArm(id),correct=grade(arm,answer(arm,expressions[id]));assert.equal(correct.verified,true);assert.equal(correct.passed,correct.total);const original=id==='interval-overlap'?op('sub',op('min',arg(1),arg(3)),op('max',arg(0),arg(2))):op('min',arg(2),op('mul',arg(1),arg(0)));const wrong=grade(arm,answer(arm,original));assert.equal(wrong.verified,false);assert(wrong.passed<wrong.total);}});
test('candidate expression data has no executable language, property access or unbounded recursion',()=>{assert.equal(evaluateExpression(op('add',arg(0),constant(2)),[3]),5);for(const value of [{op:'eval',args:[constant(1)]},{op:'arg',index:99},{op:'const',value:Infinity},{op:'arg',index:0,constructor:'payload'},op('div',constant(1),constant(0))])assert.throws(()=>evaluateExpression(value,[1]));let nested:unknown=arg(0);for(let i=0;i<20;i++)nested=op('abs',nested);assert.throws(()=>evaluateExpression(nested,[1]));});
test('wrong identities, invented source IDs, extra fields and non-JSON claims cannot pass verification',()=>{const arm=unitArm('interval-overlap'),value=JSON.parse(answer(arm,expressions['interval-overlap']));for(const input of [{...value,fixtureId:'other'},{...value,functionName:'other'},{...value,sourceIds:['not-disclosed']},{...value,verified:true}])assert.equal(grade(arm,JSON.stringify(input)).verified,false);assert.equal(grade(arm,'The tests passed.').verified,false);});
function observations():Observation[]{return ['scoped','declared-full','declared-full','scoped'].map((arm,index)=>{const fixtureId=index<2?'interval-overlap':'capped-retry',authorizationId='offline-summary';return {arm:arm as Observation['arm'],fixtureId,providerId:'openai-api-vela',executionId:'benchmark:'+authorizationId+':'+fixtureId+':'+arm,requestId:'benchmark-request:'+authorizationId+':'+index,provenance:{source:'native-turn-result',authorizationId,claimId:'offline-claim',bindingDigest:'a'.repeat(64),slot:index,sourceValidatedAfterResponse:true},verified:true,outcome:'completed',dispatched:true,reportedModel:'gpt-6-luna',usage:{source:'provider-reported',inputTokens:80,outputTokens:20,totalTokens:100},elapsedMs:1,firstOutputMs:0.5};});}
test('efficiency includes failed paid work and missing usage or model evidence prevents a savings claim',()=>{const rows=observations(),report=summarize(rows);assert.equal(report.arms[0].reportedTotalTokens,200);assert.equal(report.arms[0].cachedInputTokens,null);assert.equal(report.arms[0].cacheWriteInputTokens,null);assert.equal(report.tokenReduction,0);rows[0]={...rows[0],verified:false};const failed=summarize(rows);assert.equal(failed.arms[0].reportedTotalTokens,200);assert.equal(failed.arms[0].verified,1);assert.equal(failed.tokenReduction,null);rows[1]={...rows[1],usage:undefined};const missing=summarize(rows);assert.equal(missing.arms[1].reportedTotalTokens,null);assert.equal(missing.arms[1].verifiedObjectivesPerReportedToken,null);assert.equal(missing.tokenReduction,null);assert.equal(summarize(observations().map(item=>({...item,reportedModel:'another-model'}))).tokenReduction,null);assert.throws(()=>summarize(rows.slice(1)));});

test('summary requires exact fixture pairs, native result provenance and actual dispatch before comparing usage',()=>{
 for(const field of ['fixtureId','executionId','requestId','providerId','provenance'] as const){const rows=observations();rows[0]={...rows[0],[field]:field==='provenance'?{...rows[0].provenance,sourceValidatedAfterResponse:false}:field==='providerId'?'chatgpt-plan-responses':'other'} as Observation;assert.throws(()=>summarize(rows));}
 const duplicate=observations();duplicate[2]={...duplicate[0],arm:'declared-full'};assert.throws(()=>summarize(duplicate),'same ABBA labels cannot substitute a duplicate fixture');
 const undispatched=observations();undispatched[0]={...undispatched[0],dispatched:false};const result=summarize(undispatched);assert.equal(result.arms[0].calls,1);assert.equal(result.arms[0].reportedTotalTokens,null);assert.equal(result.tokenReduction,null);
 const mixed=observations();mixed[3]={...mixed[3],provenance:{...mixed[3].provenance,claimId:'another-claim'}};assert.throws(()=>summarize(mixed));
});
test('negative, fractional, inconsistent or unsourced token counts never become savings; optional counters remain nullable',()=>{
 for(const usage of [
  {source:'provider-reported',inputTokens:-1,outputTokens:101,totalTokens:100},
  {source:'provider-reported',inputTokens:80.5,outputTokens:19.5,totalTokens:100},
  {source:'provider-reported',inputTokens:80,outputTokens:20,totalTokens:99},
  {source:'estimated',inputTokens:80,outputTokens:20,totalTokens:100},
  {source:'provider-reported',inputTokens:80,outputTokens:20,totalTokens:100,cachedInputTokens:81},
  {source:'provider-reported',inputTokens:80,outputTokens:20,totalTokens:100,reasoningOutputTokens:-1},
  {source:'provider-reported',inputTokens:Number.MAX_SAFE_INTEGER,outputTokens:1,totalTokens:Number.MAX_SAFE_INTEGER},
 ]){const rows=observations();rows[0]={...rows[0],usage:usage as Observation['usage']};const result=summarize(rows);assert.equal(result.arms[0].reportedTotalTokens,null);assert.equal(result.tokenReduction,null);}
 const rows=observations(),missing=summarize(rows);assert.equal(missing.arms[0].reportedInputTokens,160);assert.equal(missing.arms[0].reportedOutputTokens,40);assert.equal(missing.arms[0].reasoningOutputTokens,null);assert.equal(missing.arms[0].cachedInputTokens,null);
 for(const row of rows)row.usage={...row.usage!,cachedInputTokens:0,cacheWriteInputTokens:0,reasoningOutputTokens:5};const reported=summarize(rows);assert.equal(reported.arms[0].cachedInputTokens,0);assert.equal(reported.arms[0].reasoningOutputTokens,10);
 const overflow=observations();for(const row of overflow)row.usage={source:'provider-reported',inputTokens:Number.MAX_SAFE_INTEGER-1,outputTokens:1,totalTokens:Number.MAX_SAFE_INTEGER};assert.equal(summarize(overflow).arms[0].reportedTotalTokens,null);assert.equal(summarize(overflow).tokenReduction,null);
});
test('canonical revocation after durable claim or response prevents dispatch or grading and never restores authorization',async()=>{
 for(const phase of ['claim','response'] as const){const directory=mkdtempSync(path.join(tmpdir(),'aerynth-context-benchmark-'));let pilot:Awaited<ReturnType<typeof preparePilot>>|undefined,authority:ReturnType<typeof authorityAt>|undefined;
  try{pilot=await preparePilot(path.join(directory,'canonical.sqlite'));const current=pilot,configuration={id:'offline-fence-port',version:1},auth=authorization('revoke-after-'+phase),file=path.join(directory,'authority.sqlite');authority=authorityAt(file);const host=authority;host.approve(describePilotRun(current,configuration,auth));let dispatches=0;
   const runner=createPilotRunner(current,{turn:async input=>{dispatches++;if(phase==='response')await current.archiveScopeForTest(current.arms[0]);return completed(input);}},configuration,auth,{claim:async binding=>{const claim=await host.claim(binding);if(phase==='claim')await current.archiveScopeForTest(current.arms[0]);return claim;}});
   if(phase==='claim'){await assert.rejects(runner.run(),/mission_context_/);assert.equal(dispatches,0);}else{const result=await runner.run();assert.equal(dispatches,1);assert.equal(result.complete,false);assert.equal(result.summary,null);assert('failedPhase' in result.rows[0]&&result.rows[0].failedPhase==='post-response-source-validation');assert(!('verification' in result.rows[0]));}
   host.close();authority=undefined;const reopened=new DatabaseSync(file,{readOnly:true});try{assert.equal(reopened.prepare('SELECT claimed FROM approvals WHERE id=?').get(auth.id)?.claimed,1);}finally{reopened.close();}
  }finally{authority?.close();await pilot?.close();assert.equal(path.dirname(directory),tmpdir());assert(path.basename(directory).startsWith('aerynth-context-benchmark-'));assert.equal(realpathSync(directory).toLowerCase(),path.resolve(directory).toLowerCase());rmSync(directory,{recursive:true,force:true});}
 }
});
