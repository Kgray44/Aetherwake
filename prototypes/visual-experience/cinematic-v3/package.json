{
  "name": "aerynth-cinematic-v3",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "native/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "verify": "npm run build && electron . --verify",
    "record": "npm run build && electron . --record",
    "preview": "npm run build && electron . --preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write src native tests vite.config.ts index.html package.json tsconfig.json",
    "format:check": "prettier --check src native tests vite.config.ts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "electron": "45.2.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
