import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { componentDocument,until } from './component-dom.mts';
import { pickerMotion } from './picker-motion.mts';
import { mountConversationPicker,enhanceConversationSelect,conversationControlStates } from '../src/picker.ts';
const options=[{value:'a',label:'A'},{value:'b',label:'B',disabled:true},{value:'c',label:'C'}];

test('shared MC samples alone reveal/close a picker; semantic close is inert immediately while painted descendants remain until settled',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion();let picker:any;try{picker=mountConversationPicker(dom.root,{motion:m.motion,viewId:'picker:one',label:'Provider',onSelect(){}});picker.update({items:options,value:'a'});const panel=picker.element.querySelector('.cp-picker-panel');picker.trigger.fire('click');assert.equal(picker.trigger.getAttribute('aria-expanded'),'true');assert.equal(panel.hidden,false);assert.equal(panel.inert,false);picker.frame();assert.equal(panel.style['--cp-picker-opacity'],'0');m.step(.5);picker.frame();assert.equal(panel.style['--cp-picker-opacity'],'0.5');const rows=panel.querySelectorAll('button');picker.close();assert.equal(panel.inert,true);assert.equal(panel.hidden,false);assert.equal(picker.trigger.getAttribute('aria-expanded'),'false');picker.frame();assert.equal(panel.hidden,false);assert.deepEqual(panel.querySelectorAll('button'),rows);m.step();picker.frame();assert.equal(panel.hidden,true);}finally{picker?.dispose();assert.equal(m.poses.size,0);restore();}
});

test('native keyboard focus/disabled semantics and once-only selection delegate exact values without optimistic canonical mutation',async()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion(),values:string[]=[];let picker:any;try{picker=mountConversationPicker(dom.root,{motion:m.motion,viewId:'picker:keys',label:'Provider',onSelect:value=>{values.push(value);}});picker.update({items:options,value:'a'});picker.trigger.fire('keydown',{key:'ArrowDown'});assert.equal(dom.doc.activeElement.dataset.cpOptionValue,'c');dom.doc.activeElement.fire('keydown',{key:'Home'});assert.equal(dom.doc.activeElement.dataset.cpOptionValue,'a');dom.doc.activeElement.fire('keydown',{key:'End'});const last=dom.doc.activeElement;assert.equal(last.dataset.cpOptionValue,'c');last.fire('click');last.fire('click');await until(()=>values.length===1);assert.deepEqual(values,['c']);assert.equal(picker.element.querySelector('[data-cp-option-value="a"]').getAttribute('aria-selected'),'true');picker.update({items:options,value:'c'});assert.equal(last.getAttribute('aria-selected'),'true');picker.frame();assert.equal(last.style['--cp-option-selected'],'0');m.step();picker.frame();assert.equal(last.style['--cp-option-selected'],'1');assert.equal(dom.doc.activeElement,picker.trigger);}finally{picker?.dispose();restore();}
});

test('large authorized option lists render at most64 rows and End/search reach later exact options',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion();let picker:any;try{const items=Array.from({length:500},(_,index)=>({value:'canonical:'+index,label:'Option '+index}));picker=mountConversationPicker(dom.root,{motion:m.motion,viewId:'picker:bounded',label:'Folder',onSelect(){}});picker.update({items,value:'canonical:0'});picker.open();assert.ok(picker.element.querySelectorAll('[role="option"]').length<=64);const search=picker.element.querySelector('input');search.fire('keydown',{key:'ArrowDown'});dom.doc.activeElement.fire('keydown',{key:'End'});assert.equal(dom.doc.activeElement.dataset.cpOptionValue,'canonical:499');assert.ok(picker.element.querySelectorAll('[role="option"]').length<=64);search.value='Option 427';search.fire('input');assert.equal(picker.element.querySelectorAll('[role="option"]').length,1);search.fire('keydown',{key:'ArrowDown'});assert.equal(dom.doc.activeElement.dataset.cpOptionValue,'canonical:427');}finally{picker?.dispose();restore();}
});

test('current metadata removal/disposal prevents a stale option node from dispatching and reduced motion uses host immediate samples',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion(true),values:string[]=[];let picker:any;try{picker=mountConversationPicker(dom.root,{motion:m.motion,viewId:'picker:reduced',label:'Provider',onSelect:value=>{values.push(value);}});picker.update({items:options,value:'a'});picker.open();picker.frame();assert.equal(picker.element.querySelector('.cp-picker-panel').style['--cp-picker-opacity'],'1');const old=picker.element.querySelector('[data-cp-option-value="c"]');picker.update({items:options.slice(0,1),value:'a'});old.fire('click');assert.deepEqual(values,[]);picker.close();picker.frame();assert.equal(picker.element.querySelector('.cp-picker-panel').hidden,true);picker.dispose();old.fire('click');assert.deepEqual(values,[]);assert.equal(m.poses.size,0);}finally{picker?.dispose();restore();}
});

test('native select enhancement preserves the actual value/change port and restores only owned presentation on dispose',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion();let control:any;try{const select=dom.doc.createElement('select');select.setAttribute('aria-label','History order');select.tabIndex=2;for(const item of options){const option=dom.doc.createElement('option');option.value=item.value;option.textContent=item.label;option.disabled=item.disabled===true;select.append(option);}select.value='a';let changes=0;select.addEventListener('change',()=>{changes++;});select.dispatchEvent=(event:Event)=>{select.fire(event.type);return true;};dom.root.append(select);control=enhanceConversationSelect(select,{motion:m.motion,viewId:'select:one'});assert.equal(select.hidden,true);assert.equal(select.getAttribute('aria-hidden'),'true');control.picker.open();control.picker.element.querySelector('[data-cp-option-value="c"]').fire('click');assert.equal(select.value,'c');assert.equal(changes,1);control.frame();assert.equal(control.picker.trigger.textContent,'C⌄');select.value='a';control.frame();assert.equal(changes,1);assert.equal(control.picker.trigger.textContent,'A⌄');control.dispose();assert.equal(select.hidden,false);assert.equal(select.tabIndex,2);assert.equal(select.getAttribute('aria-hidden'),null);assert.equal(select.dataset.cpNativePicker,undefined);assert.equal(m.poses.size,0);}finally{control?.dispose();restore();}
});

test('unchanged MC samples do not rewrite style and picker has no scheduler, CSS transitions or page scrolling shortcut',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion();let picker:any;try{picker=mountConversationPicker(dom.root,{motion:m.motion,viewId:'picker:writes',label:'Provider',onSelect(){}});picker.update({items:options,value:'a'});picker.frame();const panel=picker.element.querySelector('.cp-picker-panel');let writes=0;panel.style=new Proxy(panel.style,{set(target,key,value){writes++;target[key]=value;return true;}});picker.frame();picker.frame();assert.equal(writes,0);const source=readFileSync(new URL('../src/picker.ts',import.meta.url),'utf8'),css=readFileSync(new URL('../src/picker.css',import.meta.url),'utf8');assert(!/requestAnimationFrame\s*\(|setTimeout\s*\(|setInterval\s*\(|scrollIntoView\s*\(/.test(source));assert(!/\b(?:transition|animation)\s*:/.test(css));assert(source.includes('motion.pose('));assert(css.includes('var(--control-hover'));}finally{picker?.dispose();restore();}
});

test('semantic selected state is immediate while highlight glides, and manager state ownership excludes a mounted shared chat',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion();let manager,chat;try{dom.root.className='cp-manager aw-optical-controls';const row=dom.doc.createElement('button'),child=dom.doc.createElement('section'),childRow=dom.doc.createElement('button');row.className=childRow.className='cp-control';row.setAttribute('aria-current','false');child.className='cp-chat';childRow.setAttribute('aria-pressed','true');child.append(childRow);dom.root.append(row,child);manager=conversationControlStates(dom.root,{motion:m.motion,viewId:'manager:states'});chat=conversationControlStates(child,{motion:m.motion,viewId:'chat:states'});manager.frame();assert.equal(m.poses.size,1,'Manager does not duplicate child ownership');chat.frame();assert.equal(m.poses.size,2);row.setAttribute('aria-current','true');manager.frame();assert.equal(row.getAttribute('aria-current'),'true');assert.equal(row.style['--cp-control-selected'],'0');m.step(.5);manager.frame();assert.equal(row.style['--cp-control-selected'],'0.5');row.setAttribute('aria-current','false');manager.frame();m.step();manager.frame();assert.equal(row.style['--cp-control-selected'],'0');manager.dispose();chat.dispose();assert.equal(m.poses.size,0);assert.equal(row.style['--cp-control-selected'],undefined);assert.equal(childRow.style['--cp-control-selected'],undefined);}finally{manager?.dispose();chat?.dispose();restore();}
});

test('browser option observation avoids unchanged frame rescans but still samples live selection and releases only its observer',()=>{
 const dom=componentDocument(),restore=dom.install(),m=pickerMotion(),old=globalThis.MutationObserver;let control:any,notify:()=>void=()=>{},observed:unknown,disconnected=0,reads=0;
 class Observer{constructor(callback:()=>void){notify=callback;}observe(target:unknown){observed=target;}disconnect(){disconnected++;}}
 Object.assign(globalThis,{MutationObserver:Observer});
 try{const select=dom.doc.createElement('select'),a=dom.doc.createElement('option'),b=dom.doc.createElement('option');a.value='a';a.textContent='First';b.value='b';b.textContent='Second';select.append(a,b);select.value='a';Object.defineProperty(select,'options',{get(){reads++;return select.children;}});dom.root.append(select);control=enhanceConversationSelect(select,{motion:m.motion,viewId:'select:observed'});assert.equal(observed,select);assert.equal(reads,1);for(let i=0;i<10;i++)control.frame();assert.equal(reads,1,'Unchanged host frames do not clone all options');select.value='b';control.frame();assert.equal(reads,1);assert.equal(control.picker.trigger.textContent,'Second⌄');b.textContent='Renamed';notify();control.frame();assert.equal(reads,2);assert.equal(control.picker.trigger.textContent,'Renamed⌄');select.disabled=true;control.frame();assert.equal(control.picker.trigger.disabled,true);control.dispose();assert.equal(disconnected,1);const wakes=m.wakes;notify();assert.equal(m.wakes,wakes,'A late callback cannot wake a disposed view');}
 finally{control?.dispose();if(old===undefined)delete (globalThis as any).MutationObserver;else globalThis.MutationObserver=old;restore();}
});
