export function velaToolInvocation(catalog:VelaToolCatalog,text:string,fetched:ReadonlyMap<string,string>,invoked:ReadonlySet<string>):VelaToolInvocation{
 const input=parseVelaToolJson(text,32768);check(exact(input,['catalogDigest','capabilityId','schemaDigest','invocationId','argumentsJson'])&&input.catalogDigest===catalog.digest&&id(input.capabilityId)&&hash(input.schemaDigest)&&id(input.invocationId)&&typeof input.argumentsJson==='string','vela_tool_invalid_invocation');
