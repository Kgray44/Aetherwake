 if(record(value)&&(objectShape||!composition&&!Object.hasOwn(schema,'enum')&&!Object.hasOwn(schema,'const'))){check(schema.additionalProperties===false||record(schema.additionalProperties),'vela_tool_schema_unsupported');const properties=schema.properties??{};check(record(properties)&&(!schema.required||Array.isArray(schema.required)),'vela_tool_schema_unsupported');if(schema.required?.some((key:string)=>!Object.hasOwn(value,key)))return false;const names=Object.keys(value);if(names.length<(schema.minProperties??0)||names.length>(schema.maxProperties??4096))return false;for(const key of names){if(Object.hasOwn(properties,key)){if(!matchesSchema(properties[key],value[key],root,depth+1))return false;}else if(schema.additionalProperties===false||!matchesSchema(schema.additionalProperties,value[key],root,depth+1))return false;}}
