 if(typeof value==='string'){const length=Array.from(value).length;if(length<(schema.minLength??0)||length>(schema.maxLength??16384))return false;if(schema.pattern!==undefined){check(typeof schema.pattern==='string'&&schema.pattern.length<=512,'vela_tool_schema_unsupported');if(!new RegExp(schema.pattern,'u').test(value))return false;}if(schema.format!==undefined){check(['date','date-time','uuid','uri'].includes(schema.format),'vela_tool_schema_unsupported');if(schema.format==='date'&&!/^\d{4}-\d{2}-\d{2}$/.test(value)||schema.format==='date-time'&&!Number.isFinite(Date.parse(value))||schema.format==='uuid'&&!/^[a-f\d]{8}(?:-[a-f\d]{4}){3}-[a-f\d]{12}$/i.test(value))return false;if(schema.format==='uri'){try{new URL(value);}catch{return false;}}}}
