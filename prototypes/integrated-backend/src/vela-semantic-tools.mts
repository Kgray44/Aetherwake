export function validateVelaToolCatalog(value:VelaToolCatalog):VelaToolCatalog{
 plain(value);check(Buffer.byteLength(JSON.stringify(value))<=262144&&exact(value,['contract','digest','scopeDigest','discovery','descriptors'])&&value.contract==='aerynth.vela.tools@1'&&hash(value.digest)&&hash(value.scopeDigest)&&['complete','partial','failed'].includes(value.discovery)&&Array.isArray(value.descriptors)&&value.descriptors.length<=128,'vela_tool_catalog_invalid');
