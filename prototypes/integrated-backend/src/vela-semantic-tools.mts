 if(types.length&&!types.some((type:string)=>type==='null'?value===null:type==='object'?record(value):type==='array'?Array.isArray(value):type==='integer'?typeof value==='number'&&Number.isInteger(value):type==='number'?typeof value==='number'&&Number.isFinite(value):typeof value===type))return false;
