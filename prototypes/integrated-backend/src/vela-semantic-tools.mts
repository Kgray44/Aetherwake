 if(name===VELA_TOOL_DISCOVER){check(exact(query,['catalogDigest','offset','limit'])&&query.catalogDigest===catalog.digest&&Number.isSafeInteger(query.offset)&&Number(query.offset)>=0&&Number(query.offset)<=catalog.descriptors.length&&Number.isSafeInteger(query.limit)&&Number(query.limit)>=1&&Number(query.limit)<=16,'vela_tool_invalid_discovery');const offset=Number(query.offset),limit=Number(query.limit);body={catalogDigest:catalog.digest,discovery:catalog.discovery,total:catalog.descriptors.length,index:catalog.descriptors.slice(offset,offset+limit).map(index),nextOffset:offset+limit<catalog.descriptors.length?offset+limit:null};}
 else{check(name===VELA_TOOL_SCHEMAS&&exact(query,['catalogDigest','ids'])&&query.catalogDigest===catalog.digest&&Array.isArray(query.ids)&&query.ids.length>0&&query.ids.length<=4&&new Set(query.ids).size===query.ids.length,'vela_tool_invalid_discovery');const descriptors=query.ids.map(id=>{const found=catalog.descriptors.find(item=>item.id===id);check(found,catalog.discovery==='failed'?'vela_tool_discovery_failed':'vela_tool_unknown_capability');schemas.push({id:found.id,schemaDigest:found.schemaDigest});return found;});body={catalogDigest:catalog.digest,scopeDigest:catalog.scopeDigest,discovery:catalog.discovery,descriptors};}
