export function velaToolsMayRunTogether(catalog:VelaToolCatalog,a:VelaToolInvocation,b:VelaToolInvocation):boolean{const left=catalog.descriptors.find(item=>item.id===a.capabilityId),right=catalog.descriptors.find(item=>item.id===b.capabilityId);return left?.effect==='read'&&right?.effect==='read'&&!!left.readConcurrency&&!!right.readConcurrency&&left.readConcurrency.claims.every(claim=>!right.readConcurrency!.claims.includes(claim));}
export function validateVelaToolReceipt(value:VelaToolReceipt,binding:{workflowId:string;requestId:string;scopeDigest:string;invocation:VelaToolInvocation}):VelaToolReceipt{
