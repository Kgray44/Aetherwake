import {randomUUID} from 'node:crypto';

/** Private native-process injection. Never renderer RPC or serialized workerData. */
export interface NativeHostServices {
 secrets:{available():Promise<boolean>;seal(plaintext:string):Promise<Uint8Array>;open(cipher:Uint8Array):Promise<string>};
}
export const NATIVE_SECRET_LIMITS=Object.freeze({plaintextBytes:256*1024,cipherBytes:512*1024,wireBytes:1024*1024,inFlight:8,timeoutMs:15000});
export type NativeSecretOperation='available'|'seal'|'open';
export type NativeSecretCode='native_secret_unavailable'|'native_secret_protocol'|'native_secret_capacity'|'native_secret_backpressure'|'native_secret_timeout'|'native_secret_closed'|'native_secret_failed'|'os_encryption_unavailable'|'secret_reencryption_required';
const codes=new Set<NativeSecretCode>(['native_secret_unavailable','native_secret_protocol','native_secret_capacity','native_secret_backpressure','native_secret_timeout','native_secret_closed','native_secret_failed','os_encryption_unavailable','secret_reencryption_required']);
export class NativeHostError extends Error{readonly code:NativeSecretCode;constructor(code:NativeSecretCode){super(code);this.name='NativeHostError';this.code=code;}}
type OperationPayload={available:Record<string,never>;seal:{plaintext:string};open:{cipherBase64:string}};
type OperationResult={available:{available:boolean};seal:{cipherBase64:string};open:{plaintext:string}};
export type NativeSecretRequest={nativeHost:{version:1;kind:'request';id:string;purpose:'openai-auth';operation:NativeSecretOperation;payload:OperationPayload[NativeSecretOperation]}};
export type NativeSecretResponse={nativeHost:{version:1;kind:'response';id:string;purpose:'openai-auth';operation:NativeSecretOperation}&({result:OperationResult[NativeSecretOperation]}|{error:NativeSecretCode})};
const record=(value:unknown):value is Record<string,unknown>=>!!value&&typeof value==='object'&&!Array.isArray(value);
const exact=(value:Record<string,unknown>,keys:string[])=>Object.keys(value).length===keys.length&&keys.every(key=>Object.hasOwn(value,key));
const identifier=(value:unknown):value is string=>typeof value==='string'&&/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/.test(value);
const withinWire=(value:unknown)=>Buffer.byteLength(JSON.stringify(value))<=NATIVE_SECRET_LIMITS.wireBytes;
const plaintext=(value:unknown):value is string=>typeof value==='string'&&value.length<=NATIVE_SECRET_LIMITS.plaintextBytes&&Buffer.byteLength(value)<=NATIVE_SECRET_LIMITS.plaintextBytes;
export function decodeNativeCipher(value:unknown):Uint8Array|null{if(typeof value!=='string'||value.length===0||value.length>Math.ceil(NATIVE_SECRET_LIMITS.cipherBytes/3)*4||(value.length%4!==0||!/^[A-Za-z0-9+/]*={0,2}$/.test(value)))return null;const bytes=Buffer.from(value,'base64');return bytes.length>0&&bytes.length<=NATIVE_SECRET_LIMITS.cipherBytes&&bytes.toString('base64')===value?bytes:null;}
export const nativeSecretCode=(value:unknown):NativeSecretCode=>typeof value==='string'&&codes.has(value as NativeSecretCode)?value as NativeSecretCode:'native_secret_failed';
/** MUST be checked before ready/event/RPC routing, including every malformed/mixed envelope. */
export const isNativeHostEnvelope=(value:unknown):value is {nativeHost:unknown}=>record(value)&&Object.hasOwn(value,'nativeHost');
function header(value:unknown,kind:'request'|'response'):Record<string,unknown>|null{if(!isNativeHostEnvelope(value)||!exact(value as unknown as Record<string,unknown>,['nativeHost'])||!record(value.nativeHost))return null;const inner=value.nativeHost;if(inner.version!==1||inner.kind!==kind||inner.purpose!=='openai-auth'||!identifier(inner.id)||typeof inner.operation!=='string'||!['available','seal','open'].includes(inner.operation))return null;return inner;}
export function validateNativeSecretRequest(value:unknown):value is NativeSecretRequest{const inner=header(value,'request');if(!inner||!exact(inner,['version','kind','id','purpose','operation','payload'])||!record(inner.payload))return false;const p=inner.payload;if(!withinWire(value))return false;return inner.operation==='available'?exact(p,[]):inner.operation==='seal'?exact(p,['plaintext'])&&plaintext(p.plaintext):exact(p,['cipherBase64'])&&!!decodeNativeCipher(p.cipherBase64);}
export function validateNativeSecretResponse(value:unknown):value is NativeSecretResponse{const inner=header(value,'response');if(!inner)return false;if(Object.hasOwn(inner,'error'))return exact(inner,['version','kind','id','purpose','operation','error'])&&typeof inner.error==='string'&&codes.has(inner.error as NativeSecretCode);if(!exact(inner,['version','kind','id','purpose','operation','result'])||!record(inner.result))return false;const r=inner.result;if(!withinWire(value))return false;return inner.operation==='available'?exact(r,['available'])&&typeof r.available==='boolean':inner.operation==='seal'?exact(r,['cipherBase64'])&&!!decodeNativeCipher(r.cipherBase64):exact(r,['plaintext'])&&plaintext(r.plaintext);}
function limits(input:{timeoutMs?:number;inFlight?:number}={}){const result={timeoutMs:NATIVE_SECRET_LIMITS.timeoutMs,inFlight:NATIVE_SECRET_LIMITS.inFlight,...input};for(const[key,value]of Object.entries(result))if(!Number.isSafeInteger(value)||value<=0||value>NATIVE_SECRET_LIMITS[key as 'timeoutMs'|'inFlight'])throw new NativeHostError('native_secret_capacity');return result;}
export function createNativeHostClient(send:(message:NativeSecretRequest)=>void,options:{timeoutMs?:number;inFlight?:number}={}){
 const bound=limits(options),pending=new Map<string,{operation:NativeSecretOperation;resolve:(result:OperationResult[NativeSecretOperation])=>void;reject:(error:Error)=>void;timer:ReturnType<typeof setTimeout>}>();let closed=false;
 const request=(operation:NativeSecretOperation,payload:OperationPayload[NativeSecretOperation])=>new Promise<OperationResult[NativeSecretOperation]>((resolve,reject)=>{
  if(closed){reject(new NativeHostError('native_secret_closed'));return;}if(pending.size>=bound.inFlight){reject(new NativeHostError('native_secret_backpressure'));return;}const id=randomUUID(),message:NativeSecretRequest={nativeHost:{version:1,kind:'request',id,purpose:'openai-auth',operation,payload}};
  if(!validateNativeSecretRequest(message)){reject(new NativeHostError('native_secret_capacity'));return;}
  const timer=setTimeout(()=>{pending.delete(id);reject(new NativeHostError('native_secret_timeout'));},bound.timeoutMs);pending.set(id,{operation,resolve,reject,timer});try{send(message);}catch{clearTimeout(timer);pending.delete(id);reject(new NativeHostError('native_secret_closed'));}
 });
 const services:NativeHostServices={secrets:{available:async()=>{const result=await request('available',{});return (result as OperationResult['available']).available;},seal:async value=>{const result=await request('seal',{plaintext:value});return Uint8Array.from(decodeNativeCipher((result as OperationResult['seal']).cipherBase64)!);},open:async value=>{if(!(value instanceof Uint8Array)||value.length===0||value.length>NATIVE_SECRET_LIMITS.cipherBytes)throw new NativeHostError('native_secret_capacity');const result=await request('open',{cipherBase64:Buffer.from(value).toString('base64')});return (result as OperationResult['open']).plaintext;}}};
 return {services,handle(message:unknown):boolean{if(!isNativeHostEnvelope(message))return false;const raw=record(message.nativeHost)?message.nativeHost:null,p=raw&&typeof raw.id==='string'?pending.get(raw.id):null;if(!p)return true;pending.delete(String(raw!.id));clearTimeout(p.timer);if(!validateNativeSecretResponse(message)||message.nativeHost.operation!==p.operation){p.reject(new NativeHostError('native_secret_protocol'));return true;}if('error'in message.nativeHost)p.reject(new NativeHostError(message.nativeHost.error));else p.resolve(message.nativeHost.result);return true;},close(){if(closed)return;closed=true;for(const p of pending.values()){clearTimeout(p.timer);p.reject(new NativeHostError('native_secret_closed'));}pending.clear();}};
}
/** Trusted hop only. Always claim reserved envelopes synchronously, never public-fanout. */
export function createNativeHostServer(services:NativeHostServices|undefined,send:(message:NativeSecretResponse)=>void,options:{timeoutMs?:number;inFlight?:number}={}){
 const bound=limits(options),pending=new Map<string,{active:boolean;timer:ReturnType<typeof setTimeout>}>();let closed=false;
 const publish=(request:NativeSecretRequest,result:OperationResult[NativeSecretOperation]|null,error?:NativeSecretCode)=>{const h=request.nativeHost;const message:NativeSecretResponse={nativeHost:{version:1,kind:'response',id:h.id,purpose:'openai-auth',operation:h.operation,...error?{error}:{result:result!}}};try{send(validateNativeSecretResponse(message)?message:{nativeHost:{version:1,kind:'response',id:h.id,purpose:'openai-auth',operation:h.operation,error:'native_secret_capacity'}});}catch{/* private channel closed; never log or reroute */}};
 return {handle(message:unknown):boolean{if(!isNativeHostEnvelope(message))return false;if(!validateNativeSecretRequest(message))return true;const request=structuredClone(message),h=request.nativeHost;if(closed){publish(request,null,'native_secret_closed');return true;}if(!services){publish(request,null,'native_secret_unavailable');return true;}if(pending.has(h.id)){const previous=pending.get(h.id)!;previous.active=false;clearTimeout(previous.timer);pending.delete(h.id);publish(request,null,'native_secret_protocol');return true;}if(pending.size>=bound.inFlight){publish(request,null,'native_secret_backpressure');return true;}
  const finish=(result:OperationResult[NativeSecretOperation]|null,error?:NativeSecretCode)=>{if(!entry.active||closed)return;entry.active=false;clearTimeout(entry.timer);pending.delete(h.id);publish(request,result,error);};
  const entry={active:true,timer:setTimeout(()=>finish(null,'native_secret_timeout'),bound.timeoutMs)};pending.set(h.id,entry);
  void Promise.resolve().then(async()=>{let result:OperationResult[NativeSecretOperation];switch(h.operation){case'available':{const value=await services.secrets.available();if(typeof value!=='boolean')throw new NativeHostError('native_secret_protocol');result={available:value};break;}case'seal':{const value=await services.secrets.seal((h.payload as OperationPayload['seal']).plaintext);if(!(value instanceof Uint8Array)||value.length===0||value.length>NATIVE_SECRET_LIMITS.cipherBytes)throw new NativeHostError('native_secret_capacity');result={cipherBase64:Buffer.from(value).toString('base64')};break;}case'open':{const value=await services.secrets.open(Uint8Array.from(decodeNativeCipher((h.payload as OperationPayload['open']).cipherBase64)!));if(!plaintext(value))throw new NativeHostError('native_secret_capacity');result={plaintext:value};break;}}finish(result);}).catch(error=>finish(null,nativeSecretCode(record(error)?error.code:undefined)));return true;},close(){closed=true;for(const p of pending.values()){p.active=false;clearTimeout(p.timer);}pending.clear();}};
}
