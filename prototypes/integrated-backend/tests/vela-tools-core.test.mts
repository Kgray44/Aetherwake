  assert.equal(f.requests.length,fault==='new-user'?3:2);assert.equal(f.codex,0);assert.equal((await f.state()).conversation!.messages.filter(message=>message.role==='user').length,fault==='new-user'?2:1);assert.equal((await f.state()).conversation!.messages.filter(message=>message.role==='assistant').length,fault==='new-user'?1:0);assert.equal((await f.core.command('desktop',{type:'snapshot'})).workspaces.length,0);
 }finally{await f.close();}}
});

test('cancelling during a source-denial continuation keeps the parent cancelled and never adopts the late provider answer',async()=>{
 const f=fixture();let release=()=>{};try{const {request,plan,host}=await prepareReviewedWorkspace(f);let entered!:()=>void;const started=new Promise<void>(done=>{entered=done;}),held=new Promise<void>(done=>{release=done;});f.replies.push(async()=>{entered();await held;return answer('This late answer must not be adopted.');});const rejecting=f.core.command('vela',{name:'review',input:{planId:plan.id,fingerprint:plan.fingerprint,decision:'reject'}});await started;await f.core.command('vela',{name:'cancel',input:request.id});release();await rejecting;const final=await f.state();assert.equal(final.requests.find(item=>item.id===request.id)!.state,'cancelled');assert.equal(final.conversation!.messages.filter(message=>message.role==='user').length,1);assert.equal(final.conversation!.messages.filter(message=>message.role==='assistant').length,0);assert.equal(f.requests.length,3);assert.equal(f.codex,0);assert.equal((f.core as any).toolWorkflows.ownerOperations('application-plan').find((op:any)=>op.view.id===host.id).view.state,'denied');assert.equal((await f.core.command('desktop',{type:'snapshot'})).workspaces.length,0);assert(Object.values((await f.core.command('snapshot',{})).executions).some(execution=>execution.state==='unknown'),'dispatched provider uncertainty remains recorded without claiming cancellation');
 }finally{release();await f.close();}
});

