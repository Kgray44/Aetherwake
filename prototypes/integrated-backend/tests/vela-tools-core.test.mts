  if(fault==='cancel'){await f.core.command('vela',{name:'cancel',input:request.id});await assert.rejects(owner.vela.resumeToolRequest(request.id,async()=>{throw Error('Cancelled workflow must never resume');}),/vela_tool_resume_unavailable/);await assert.rejects(f.core.command('vela',{name:'review',input:{planId:plan.id,fingerprint:plan.fingerprint,decision:'reject'}}),/plan_not_reviewable/);assert.equal((await f.state()).requests.find(item=>item.id===request.id)!.state,'cancelled');}
