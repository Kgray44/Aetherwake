  const rolledBack=await f.state();assert.equal(rolledBack.plans.find(item=>item.id===plan.id)!.state,'prepared');assert.equal(rolledBack.hostOperations!.find(op=>op.id===host.id)!.state,'awaiting-review');assert.equal(f.requests.length,2);
