test('maintenance utterances reach the same primary tool loop and measured healthy fixtures perform no mutation',async()=>{
 for(const intent of ['Vela, trim the RAM on my computer.','Free some memory.','Reduce memory usage.','My computer feels sluggish. Investigate it.','Could you find out why switching between my applications feels sticky?']){
  const f=fixture();try{await f.ready();f.replies.push(c=>tool(VELA_TOOL_SCHEMAS,{catalogDigest:c.digest,ids:['windows.memory.diagnose']}),c=>invoke(c,'windows.memory.diagnose',{}),()=>answer('The measured memory pressure is healthy. I made no changes.'));
   const result=await f.send(intent),state=await f.state();assert.equal(result.state,'responded');assert.equal(f.reads,1);assert.equal(f.codex,0);assert.equal(f.requests.length,3);assert.equal(state.requests.length,1);assert.equal(state.conversation!.messages.filter(m=>m.role==='user').length,1);assert.equal(state.conversation!.messages.find(m=>m.role==='user')!.content,intent);assert.equal(state.hostOperations!.length,0);
  }finally{await f.close();}
 }
});
