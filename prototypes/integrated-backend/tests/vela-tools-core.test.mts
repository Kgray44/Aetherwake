 }finally{await f.close();}
});

test('three same-request specialist jobs use the existing scheduler and shared budget, then resume only on actual completion',async()=>{
 const f=fixture(),releases:(()=>void)[]=[];try{await f.ready();await f.core.command('desktop',{type:'createWorkspace',title:'Synthetic comparative experiments',projectId:null});const tasks=[{id:'first',objective:'Identify controlled baseline experiments.',role:'Baseline investigator',instructions:'Keep claims conditional and source-free.',dependencies:[]},{id:'second',objective:'Identify competing explanations.',role:'Independent reviewer',instructions:'Distinguish reports from measured facts.',dependencies:[]},{id:'third',objective:'Compare the first report against reproducibility criteria.',role:'Synthesis reviewer',instructions:'Use only the named verified prerequisite receipt.',dependencies:['first']}];f.replies.push(c=>tool(VELA_TOOL_SCHEMAS,{catalogDigest:c.digest,ids:['specialist.prepare']}),c=>invoke(c,'specialist.prepare',{objective:'Compare reproducible experiments using three scoped reviewers.',tasksJson:JSON.stringify(tasks)}));const request=await f.send('Use three independent specialist perspectives to compare reproducible experimental designs.');assert.equal(request.state,'awaiting-review');const host=(await f.state()).hostOperations!.find(o=>o.capabilityId==='specialist.prepare')!,native=await claimOwner(f,host.id);assert.equal(native.binding.owner,'specialist-mission');if(native.binding.owner!=='specialist-mission')throw Error('Expected mission owner');const ref=native.binding.ownerRef;
  for(let i=0;i<2;i++)f.replies.push(async()=>{await new Promise<void>(done=>releases.push(done));return answer(JSON.stringify({observations:['Controlled baseline comparisons need identical workloads.','Independent controls are necessary before attributing a cause.']}));});f.replies.push(()=>answer(JSON.stringify({observations:['Named prerequisite receipts support a bounded comparison.','These specialist reports remain analysis rather than measured facts.']})),()=>answer('Three scoped specialist reports are available. The overall conclusion remains partial without independent measurements.'));
  const mission=await f.core.command('missionStartReviewed',{objective:ref.objective,proposalId:ref.id,fingerprint:ref.digest,requestId:ref.id}) as import('../src/mission-contracts.mts').MissionProjection;const wait=async(accept:()=>boolean)=>{for(let i=0;i<400;i++){if(accept())return;await new Promise(done=>setTimeout(done,5));}throw Error('Synthetic job condition did not settle '+JSON.stringify({httpRequests:f.requests.length,requests:(f.core as any).vela.state().requests.map((r:any)=>({state:r.state,error:r.errorCode,workflow:r.toolWorkflow})),host:(f.core as any).toolWorkflows.hostOperations(),mission:(f.core as any).missions.read(mission.id,mission.scope)}));};await wait(()=>releases.length===2);assert.equal(f.requests.length,4,'two primary stages and two concurrent existing scheduler workers');const running=await f.core.command('hostOperationResultNative',native);assert.equal(running.state,'running');assert.equal(f.requests.length,4,'pending owner jobs do not produce a paid continuation poll');releases.splice(0).forEach(done=>done());await wait(()=>f.requests.length>=6);await wait(()=>{const owner=f.core as any;return owner.vela.state().requests.find((r:any)=>r.id===request.id)?.state!=='planning';});const state=await f.state(),final=state.requests.find(r=>r.id===request.id)!;assert.equal(final.state,'responded',JSON.stringify({state:final.state,error:final.errorCode,workflow:final.toolWorkflow,host:state.hostOperations}));assert.equal(f.requests.length,6);assert.equal(state.requests.length,1);assert.equal(state.conversation!.messages.filter(m=>m.role==='user').length,1);assert.equal((f.core as any).toolWorkflows.stateForRequest(request.id).budget.providerRequests,6);const actual=await f.core.command('missions',{name:'read',input:{id:mission.id}}) as import('../src/mission-contracts.mts').MissionProjection;assert.equal(actual.tasks.length,3);assert(actual.tasks.every(task=>task.attempts.length===1));assert.equal(actual.profile.providerCalls,3);assert.equal(actual.coverage?.status,'partial');assert.equal(f.codex,0);assert.equal(state.hostOperations!.filter(op=>op.capabilityId==='specialist.prepare').reduce((n,op)=>n+(op.jobsDone??0),0),0,'mission report owns job counts; preparation does not double count');
 }finally{releases.splice(0).forEach(done=>done());await f.close();}
});

