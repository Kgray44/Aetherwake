import test from 'node:test';import assert from 'node:assert/strict';import {mkdtempSync,rmSync,writeFileSync,readFileSync,realpathSync,statfsSync} from 'node:fs';import {tmpdir} from 'node:os';import {join,dirname,relative,isAbsolute} from 'node:path';import {ownedFileEditAdmission,FIXTURE_FILE_EDIT_BYTES} from './fixture-file-edit-admission.mts';
test('fixture admission uses actual free bytes only for the canonical owned roots',()=>{const base=realpathSync.native(tmpdir()),root=mkdtempSync(join(base,'mfe-admission-'));try{const file=join(root,'source.mjs');writeFileSync(file,'SYNTHETIC');const admit=ownedFileEditAdmission([root]);assert.doesNotThrow(()=>admit(file,root));const stats=statfsSync(root,{bigint:true});assert(stats.bsize*stats.bavail>=BigInt(2*FIXTURE_FILE_EDIT_BYTES));assert.equal(readFileSync(file,'utf8'),'SYNTHETIC');assert.throws(()=>admit(join(dirname(root),'foreign.mjs')),/fixture_storage_scope_escape/);assert.throws(()=>admit(file,dirname(root)),/fixture_storage_scope_escape/);assert.throws(()=>ownedFileEditAdmission([base]),/fixture_storage_broad_root/);}finally{const part=relative(base,root);assert(part.startsWith('mfe-admission-')&&!isAbsolute(part)&&!part.startsWith('..'));rmSync(root,{recursive:true,force:true});}});
test('an injected insufficient-volume observation denies before fixture file mutation',()=>{const base=realpathSync.native(tmpdir()),root=mkdtempSync(join(base,'mfe-admission-'));try{const file=join(root,'source.mjs');writeFileSync(file,'SYNTHETIC');const unavailable=(()=>({bsize:4096n,bavail:0n})) as unknown as typeof statfsSync;assert.throws(()=>ownedFileEditAdmission([root],unavailable)(file),/fixture_storage_admission_denied/);assert.equal(readFileSync(file,'utf8'),'SYNTHETIC');}finally{assert(relative(base,root).startsWith('mfe-admission-'));rmSync(root,{recursive:true,force:true});}});
