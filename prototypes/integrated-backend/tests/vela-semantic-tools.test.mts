test('context advance rejects corrupt, foreign, unvalidated, wrong-receipt or prompt/pin drift before another HTTP request',async()=>{
 for(const kind of ['validator','prior','proof','receipt','scope','prompt','pins']as const){const f=fixture([descriptor('prepare.a','a','prepare')]);try{await f.ready();f.handler=async input=>f.receipt(input,'awaiting-review');f.replies.push(()=>f.schemaReply(),()=>f.reply([f.invoke('prepare.a')]));const paused=await f.run(),replacement=f.receipt(f.invocations[0]),prompt='Synthetic approved context',contextDigest='c'.repeat(64),certificate={priorContextDigest:kind==='prior'?'f'.repeat(64):f.input.contextDigest,nextContextDigest:contextDigest,ownerReceiptId:kind==='receipt'?'foreign-receipt':replacement.id,sourceProofDigest:kind==='proof'?'invalid':sha('synthetic owner proof')};
 const extra:Partial<VelaApiRun>={resume:paused.workflow!.continuation!,resumeReceipt:replacement,resumeContext:certificate,prompt:kind==='prompt'?'Unapproved replacement question':prompt,contextDigest,...(kind==='pins'?{reasoningEffort:'high' as const}:{})};if(kind!=='validator')extra.validateResumeContext=(_proof,binding)=>{assert.notEqual(kind,'scope','synthetic foreign scope');assert.equal(binding.promptDigest,sha(prompt));};
 let rejected=false;try{const result=await f.run(extra);rejected=result.workflow?.phase==='blocked';}catch{rejected=true;}assert(rejected,kind);assert.equal(f.requests.length,2);assert.equal(f.invocations.length,1);
 }finally{f.close();}}
});
test('context proof is checked again after asynchronous native credential resolution, before provider egress',async()=>{
 const f=fixture([descriptor('prepare.a','a','prepare')]);try{await f.ready();f.handler=async input=>f.receipt(input,'awaiting-review');f.replies.push(()=>f.schemaReply(),()=>f.reply([f.invoke('prepare.a')]));const paused=await f.run(),replacement=f.receipt(f.invocations[0]);let current=true,checked=0;const connection=(f.runtime as any).options.connection,resolve=connection.resolveNativeCredential.bind(connection);connection.resolveNativeCredential=async(...args:any[])=>{const value=await resolve(...args);current=false;return value;};
 const result=await f.run({resume:paused.workflow!.continuation!,resumeReceipt:replacement,prompt:'Synthetic approved owner effect context',contextDigest:'c'.repeat(64),resumeContext:{priorContextDigest:f.input.contextDigest,nextContextDigest:'c'.repeat(64),ownerReceiptId:replacement.id,sourceProofDigest:sha('synthetic approved proof')},validateResumeContext(){checked++;assert(current,'synthetic revoked owner proof');}});assert(checked>4);assert.equal(result.result.dispatched,false);assert.equal(result.workflow?.phase,'blocked');assert.equal(f.requests.length,2);assert.equal(f.invocations.length,1);
 }finally{f.close();}
});
test('standing source-owned mutation advances context in the same loop before the next model request without resetting budget or pins',async()=>{
 const d={...descriptor('mutate.a','a','mutate'),authorization:'host-policy' as const},f=fixture([d]);try{await f.ready();let version=1,advances=0,validated=0;const prompt='Original synthetic request plus canonical source version 2',contextDigest='c'.repeat(64),deadline=f.port.budget.deadline;f.handler=async input=>{version++;return f.receipt(input);};f.replies.push(()=>f.schemaReply(),()=>f.reply([f.invoke('mutate.a')]),body=>{assert.equal(version,2);assert.equal(body.input[0].content,prompt);assert.equal(body.model,'gpt-6-luna');return f.reply();});const result=await f.run({advanceContext(receipts){advances++;assert.equal(receipts.length,1);assert.equal(version,2);return {prompt,contextDigest,resumeContext:{priorContextDigest:f.input.contextDigest,nextContextDigest:contextDigest,ownerReceiptId:receipts[0].id,sourceProofDigest:sha('actual synthetic CAS version 2')}};},validateResumeContext(proof,binding){validated++;assert.equal(version,2);assert.equal(proof.nextContextDigest,contextDigest);assert.equal(binding.promptDigest,sha(prompt));}});assert.equal(result.workflow?.phase,'partial');assert.equal(advances,1);assert(validated>4);assert.equal(f.requests.length,3);assert.equal(f.invocations.length,1);assert.equal(f.port.budget.providerRequests,3);assert.equal(f.port.budget.toolCalls,2);assert.equal(f.port.budget.deadline,deadline);assert.deepEqual(f.db.prepare('SELECT context_digest FROM vela_api_runs ORDER BY rowid').all().map(row=>row.context_digest),[f.input.contextDigest,f.input.contextDigest,contextDigest]);}finally{f.close();}
});
test('a foreign source CAS detected by the existing composer blocks same-loop continuation after a real owner receipt',async()=>{
 const f=fixture([{...descriptor('mutate.a','a','mutate'),authorization:'host-policy' as const}]);try{await f.ready();f.replies.push(()=>f.schemaReply(),()=>f.reply([f.invoke('mutate.a')]));const result=await f.run({advanceContext(){throw Error('synthetic external CAS is not an approved owner effect');},validateResumeContext(){}});assert.equal(result.workflow?.phase,'blocked');assert.equal(f.requests.length,2);assert.equal(f.invocations.length,1);}finally{f.close();}
});
test('actual clockTimer source schema permits strict union wrappers while unbounded object children stay rejected',()=>{
 const capability=CAPABILITIES.find(item=>item.id==='clockTimer')!,d={...descriptor('application.clockTimer'),schema:capability.schema,schemaDigest:velaToolSchemaDigest(capability.schema)},base={contract:'aerynth.vela.tools@1' as const,scopeDigest:'a'.repeat(64),discovery:'complete' as const,descriptors:[d]},catalog:VelaToolCatalog={...base,digest:velaToolCatalogDigest(base)};
 const action={type:'clockTimer',workspaceId:'workspace-1',request:{name:'create',input:{title:'Calibration timer',projectId:null,operations:[{type:'createTimer',key:'measurement',name:'Measurement',durationMs:60000,start:false}]}},focus:{mode:'timer',timerId:null,timerKey:'measurement'},query:null};assert(validClockTimerAction(action));const invoke=()=>velaToolInvocation(catalog,JSON.stringify({catalogDigest:catalog.digest,capabilityId:d.id,schemaDigest:d.schemaDigest,invocationId:'timer-invocation',argumentsJson:JSON.stringify(action)}),new Map([[d.id,d.schemaDigest]]),new Set());assert.doesNotThrow(invoke);
 const malformed={...action,request:{name:'create',input:{...action.request.input,path:'C:\\private'}}};assert.throws(()=>velaToolInvocation(catalog,JSON.stringify({catalogDigest:catalog.digest,capabilityId:d.id,schemaDigest:d.schemaDigest,invocationId:'invalid-timer',argumentsJson:JSON.stringify(malformed)}),new Map([[d.id,d.schemaDigest]]),new Set()),/invalid_arguments/);
 const unsafe=descriptor('unsafe.read');unsafe.schema={type:'object'};unsafe.schemaDigest=velaToolSchemaDigest(unsafe.schema);const badBase={...base,descriptors:[unsafe]},bad={...badBase,digest:velaToolCatalogDigest(badBase)};assert.throws(()=>velaToolInvocation(bad,JSON.stringify({catalogDigest:bad.digest,capabilityId:unsafe.id,schemaDigest:unsafe.schemaDigest,invocationId:'unsafe-invocation',argumentsJson:'{}'}),new Map([[unsafe.id,unsafe.schemaDigest]]),new Set()),/schema_unsupported/);
});

test('canonical owner admissions advance the shared provider budget during pause without resetting continuation counters',async()=>{
 const f=fixture();try{await f.ready();f.handler=async input=>f.receipt(input,'running');f.replies.push(()=>f.schemaReply(),()=>f.reply([f.invoke('read.a')]));const paused=await f.run(),deadline=f.port.budget.deadline;assert.equal(f.port.budget.providerRequests,2);f.recordSourceAdmissions(2);f.replies.push(()=>f.reply());const done=await f.run({resume:paused.workflow!.continuation!,resumeReceipt:f.receipt(f.invocations[0])});assert.equal(done.workflow?.phase,'partial');assert.equal(f.requests.length,3);assert.equal(f.port.budget.providerRequests,5);assert.equal(f.port.budget.deadline,deadline);assert.equal(f.invocations.length,1);assert.equal(f.port.budget.toolCalls,2);
 }finally{f.close();}
});
