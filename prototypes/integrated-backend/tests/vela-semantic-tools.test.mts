 return {db,port,input,requests,replies,invocations,phases,receipt,reply,invoke,recordSourceAdmissions(count:number){sourceAdmissions+=count;port.budget.providerRequests+=count;},get runtime(){return runtime;},set handler(value:VelaToolPort['invoke']){handler=value;},revoke(){live=false;},schemaReply(ids=descriptors.map(item=>item.id)){return reply([{name:VELA_TOOL_SCHEMAS,args:{catalogDigest:catalog.digest,ids}}]);},async ready(){await connection.configureNative({configurationId:'vela-primary',apiKey:'SYNTHETIC_ONLY_SEMANTIC_TOOLS'},null);await connection.catalog(1);runtime.authorizeUsage(1,true);},restart(){runtime.close();atomic(()=>VelaApiRuntime.migrate(db));runtime=new VelaApiRuntime({db,transaction:atomic,connection,test:{fetch:fetchFixture}});},async run(extra:Partial<VelaApiRun>={}){return runtime.run({...input,...extra},new AbortController().signal);},close(){runtime.close();connection.close();db.close();}};
