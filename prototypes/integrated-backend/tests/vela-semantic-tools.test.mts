 const db=new DatabaseSync(':memory:'),key=randomBytes(32),requests:any[]=[],replies:((body:any)=>Response|Promise<Response>)[]=[],proofs=new Map<string,string>(),phases:{phase:VelaWorkflowPhase;reason?:string}[]=[],invocations:VelaToolInvocation[]=[];let live=true,serial=0,sourceAdmissions=0;
 const atomic=<T,>(fn:()=>T):T=>{db.exec('BEGIN');try{const result=fn();db.exec('COMMIT');return result;}catch(error){db.exec('ROLLBACK');throw error;}};
 atomic(()=>{VelaApiConnection.migrate(db);VelaApiRuntime.migrate(db);});
 const fetchFixture=(async(url,init)=>{if(String(url).endsWith('/models'))return Response.json({data:[{id:'gpt-6-luna'}]});assert.equal(String(url),'https://api.openai.com/v1/responses');const body=JSON.parse(String(init?.body));requests.push(body);assert.equal(port.budget.providerRequests,requests.length+sourceAdmissions);const reply=replies.shift();assert(reply,'unexpected synthetic provider stage');return reply(body);})as typeof fetch;
 const connection=new VelaApiConnection({db,transaction:fn=>atomic(()=>fn(db)),fetch:fetchFixture,nativeHost:{secrets:{available:async()=>true,seal:async text=>{const iv=randomBytes(12),cipher=createCipheriv('aes-256-gcm',key,iv);return Buffer.concat([iv,cipher.update(text),cipher.final(),cipher.getAuthTag()]);},open:async value=>{const bytes=Buffer.from(value),cipher=createDecipheriv('aes-256-gcm',key,bytes.subarray(0,12));cipher.setAuthTag(bytes.subarray(-16));return Buffer.concat([cipher.update(bytes.subarray(12,-16)),cipher.final()]).toString();}}}});
