 let handler:VelaToolPort['invoke']=async input=>receipt(input);
 const port:VelaToolPort={workflowId:'workflow-synthetic',catalog,budget:{maxProviderRequests:12,maxToolCalls:16,providerRequests:0,toolCalls:0,deadline:new Date(Date.now()+90000).toISOString()},validate(){assert(live,'synthetic_scope_revoked');},discovered(input){assert(db.prepare('SELECT 1 FROM vela_api_tool_receipts WHERE execution_id=? AND call_id=?').get(input.executionId,input.callId),'schema proof must follow durable tool receipt');for(const item of input.schemas)proofs.set(item.id,item.schemaDigest);},async invoke(input,signal){assert.equal(proofs.get(input.capabilityId),input.schemaDigest);assert(port.budget.toolCalls>0);invocations.push(input);return handler(input,signal);},checkpoint(phase,reason){phases.push({phase,reason});}};
 const reply=(calls?:{name:string;args:unknown;callId?:string}[],text='Synthetic reported answer')=>{const id='response-'+ ++serial,output=calls?calls.map((call,index)=>({type:'function_call',id:'item-'+serial+'-'+index,call_id:call.callId??'call-'+serial+'-'+index,name:call.name,arguments:typeof call.args==='string'?call.args:JSON.stringify(call.args),status:'completed'})):[{type:'message',id:'message-'+serial,role:'assistant',status:'completed',content:[{type:'output_text',text,annotations:[]}]}];const events=[{type:'response.created',response:{id}},...(!calls?[{type:'response.output_text.delta',delta:text}]:[]),{type:'response.completed',response:{id,status:'completed',model:'gpt-6-luna',output,usage:{input_tokens:20,output_tokens:5,total_tokens:25}}}];return new Response(events.map(event=>'data: '+JSON.stringify(event)+'\n\n').join(''),{headers:{'content-type':'text/event-stream'}});};
