test('actual runtime overlaps two source-declared independent reads, persists proofs before invoke and returns receipts in call order',async()=>{
 const f=fixture();try{await f.ready();let entered=0,notify!:()=>void,releaseA!:()=>void,releaseB!:()=>void;const both=new Promise<void>(resolve=>{notify=resolve;}),a=new Promise<void>(resolve=>{releaseA=resolve;}),b=new Promise<void>(resolve=>{releaseB=resolve;});f.handler=async input=>{if(++entered===2)notify();await(input.capabilityId==='read.a'?a:b);return f.receipt(input);};f.replies.push(()=>f.schemaReply(),body=>{assert.equal(body.parallel_tool_calls,true);return f.reply([f.invoke('read.a'),f.invoke('read.b',2)]);},body=>{const outputs=body.input.filter((item:any)=>item.type==='function_call_output').map((item:any)=>JSON.parse(item.output)).filter((item:any)=>item.contract==='aerynth.vela.tool-receipt@1');assert.deepEqual(outputs.map((item:any)=>item.capabilityId),['read.a','read.b']);return f.reply();});
 const running=f.run();await enteredOrEnded(both,running);assert.equal(entered,2);assert.equal(f.requests.length,2);releaseB();await tick();releaseA();const result=await running;assert.equal(result.workflow?.phase,'partial');assert.equal(result.result.taskVerified,false);assert.equal(f.requests.length,3);assert.equal(f.port.budget.toolCalls,3);assert.equal(f.port.budget.providerRequests,3);assert.equal(f.invocations.length,2);assert.equal(f.db.prepare('SELECT count(*) AS n FROM vela_api_tool_receipts').get()!.n,3);
 }finally{f.close();}
});
