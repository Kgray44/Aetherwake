import test from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {createWindowsComputerClient,createWindowsComputerServer,validWindowsComputerAction,validWindowsComputerResult,validWindowsComputerReceipt,WINDOWS_COMPUTER_ACTION_SCHEMA} from '../src/windows-computer-host.mts';
import {velaToolSchemaDigest,velaToolCatalogDigest,velaToolInvocation} from '../src/vela-semantic-tools.mts';
import type {NativeWindowsComputerServices} from '../src/windows-computer-host.mts';
import type {VelaToolCatalog,VelaToolDescriptor} from '../../application-contract/vela-tools.ts';
const scope={requestId:'request-1',workflowId:'workflow-1',scopeDigest:'a'.repeat(64)},bounds={x:-800,y:0,width:800,height:600};
const discovery=()=>({contract:'aerynth.windows.computer@1' as const,snapshotId:randomUUID(),observedAt:new Date().toISOString(),partial:false,windows:[{ref:'window-1',application:'Synthetic app',state:'normal' as const,bounds,eligible:true}],applications:[{ref:'app-1',name:'Synthetic app'}]});
const observation=()=>({contract:'aerynth.windows.window-observation@1' as const,snapshotId:'snapshot-1',windowRef:'window-1',observedAt:new Date().toISOString(),trust:'untrusted-application-data' as const,partial:false,controls:[{ref:'control-1',name:'[password control]',role:'edit',enabled:true,password:true,bounds}]});
const tick=()=>new Promise<void>(resolve=>setImmediate(resolve));
test('closed source action union rejects raw paths, command strings, unknown keys, invalid geometry and password-like hidden fields',()=>{
 const actions=[{type:'select-window'},{type:'select-window',windowRef:'window-1'},{type:'launch',applicationRef:'app-1'},...['activate','minimize','maximize','restore'].map(type=>({type,windowRef:'window-1'})),{type:'move-resize',windowRef:'window-1',x:-800,y:0,width:800,height:600},{type:'invoke-control',windowRef:'window-1',controlRef:'control-1',snapshotId:'snapshot-1'},{type:'set-text',windowRef:'window-1',controlRef:'control-1',snapshotId:'snapshot-1',text:'Synthetic text'}];
 const descriptor:VelaToolDescriptor={id:'windows.computer.prepare',family:'windows',owner:'windows.computer',label:'Prepare computer action',description:'Synthetic source-owned native review boundary',availability:'available',effect:'prepare',authorization:'native-review',scope:'One scoped synthetic window',schema:WINDOWS_COMPUTER_ACTION_SCHEMA,schemaDigest:velaToolSchemaDigest(WINDOWS_COMPUTER_ACTION_SCHEMA)};const base={contract:'aerynth.vela.tools@1' as const,scopeDigest:scope.scopeDigest,discovery:'complete' as const,descriptors:[descriptor]},catalog:VelaToolCatalog={...base,digest:velaToolCatalogDigest(base)};
 for(const action of actions){assert(validWindowsComputerAction(action));assert.doesNotThrow(()=>velaToolInvocation(catalog,JSON.stringify({catalogDigest:catalog.digest,capabilityId:descriptor.id,schemaDigest:descriptor.schemaDigest,invocationId:randomUUID(),argumentsJson:JSON.stringify(action)}),new Map([[descriptor.id,descriptor.schemaDigest]]),new Set()));assert(!validWindowsComputerAction({...action,path:'C:\\private'}));}
 for(const action of [{type:'launch',command:'not-allowed'},{type:'move-resize',windowRef:'window-1',x:Infinity,y:0,width:0,height:10},{type:'set-text',windowRef:'window-1',controlRef:'control-1',snapshotId:'snapshot-1',text:'x'.repeat(2049)}])assert(!validWindowsComputerAction(action));
});
test('public projection validates exact privacy fields, password redaction and honest coverage without invoking getters',()=>{
 const value=discovery();assert(validWindowsComputerResult('discover',value));for(const extra of [{title:'PRIVATE caption'},{pid:42},{identity:{sid:'PRIVATE'}}])assert(!validWindowsComputerResult('discover',{...value,windows:[{...value.windows[0],...extra}]}));assert(!validWindowsComputerResult('discover',{...value,windows:[null]}));const observed=observation();assert(validWindowsComputerResult('observe',observed));assert(!validWindowsComputerResult('observe',{...observed,controls:[{...observed.controls[0],name:'PRIVATE password'}]}));assert(!validWindowsComputerResult('observe',{...observed,controls:[{...observed.controls[0],value:'PRIVATE password'}]}));assert(!validWindowsComputerResult('discover',{...value,coverage:{windowsObserved:2,windowsReturned:1,applicationsObserved:1,applicationsReturned:1}}));assert(validWindowsComputerResult('discover',{...value,partial:true,coverage:{windowsObserved:2,windowsReturned:1,applicationsObserved:1,applicationsReturned:1}}));let getters=0;const hostile=Object.defineProperty({},'contract',{enumerable:true,get(){getters++;return value.contract;}});assert(!validWindowsComputerResult('discover',hostile));assert.equal(getters,0);
});
test('receipt verification is criterion/action bound; selection, Invoke S_OK and launch acknowledgement cannot become a completed result',()=>{
 const receipt={contract:'aerynth.windows.computer-receipt@1',id:'receipt-1',operationId:'operation-1',operationDigest:'b'.repeat(64),observedAt:new Date().toISOString(),state:'observed',reason:'criterion-observed',claimId:'claim-1',identityDigest:'c'.repeat(64),approvalDigest:'d'.repeat(64),nativeCallSucceeded:true,verification:'verified',outputJson:JSON.stringify({action:'activate',criterion:'foreground-matches',windowRef:'window-1'})};assert(validWindowsComputerReceipt(receipt,{type:'activate',windowRef:'window-1'}));assert(!validWindowsComputerReceipt({...receipt,outputJson:JSON.stringify({action:'invoke-control',criterion:'invoke-acknowledged',windowRef:'window-1',controlRef:'control-1',snapshotId:'snapshot-1'})}));assert(!validWindowsComputerReceipt({...receipt,outputJson:JSON.stringify({action:'launch',criterion:'launch-acknowledged',applicationRef:'app-1'})}));assert(!validWindowsComputerReceipt({...receipt,outputJson:JSON.stringify({action:'launch',criterion:'state-matches',applicationRef:'app-1'})}));assert(!validWindowsComputerReceipt({...receipt,outputJson:JSON.stringify({action:'activate',criterion:'foreground-matches',windowRef:'window-1',pid:42})}));assert(!validWindowsComputerReceipt({...receipt},{type:'activate',windowRef:'foreign-window'}));const selected={...receipt,state:'no-op',claimId:null,identityDigest:null,approvalDigest:null,nativeCallSucceeded:null,verification:'unverified',reason:'selection-granted',outputJson:JSON.stringify({action:'select-window',criterion:'window-selected',windowRef:'window-1',selectionExpiresAt:new Date(Date.now()+30000).toISOString()})};assert(validWindowsComputerReceipt(selected));assert(!validWindowsComputerReceipt({...selected,state:'observed',verification:'verified'}));
});
test('actual private client/server two hops preserve scope, redacted output and window-response binding',async()=>{
 let serverA:ReturnType<typeof createWindowsComputerServer>,serverB:ReturnType<typeof createWindowsComputerServer>;const seen:any[]=[];
 const clientA=createWindowsComputerClient(message=>serverA.handle(message)),clientB=createWindowsComputerClient(message=>serverB.handle(message));const services:NativeWindowsComputerServices={discover:async input=>{seen.push(input);return discovery();},observe:async input=>{seen.push(input);return observation();}};serverA=createWindowsComputerServer(clientB.services,message=>clientA.handle(message));serverB=createWindowsComputerServer(services,message=>clientB.handle(message));try{assert(validWindowsComputerResult('discover',await clientA.services.discover(scope)));assert(validWindowsComputerResult('observe',await clientA.services.observe({...scope,windowRef:'window-1'})));assert.deepEqual(seen,[scope,{...scope,windowRef:'window-1'}]);}finally{clientA.close();clientB.close();serverA.close();serverB.close();}
});
test('client rejects malformed and foreign-window responses and then accepts only its exact typed reply',async()=>{
 const sent:any[]=[],client=createWindowsComputerClient(message=>sent.push(message));try{const running=client.services.observe({...scope,windowRef:'window-1'}),request=sent[0].computerHost;client.handle({computerHost:{version:1,kind:'response',id:request.id,operation:'observe',result:{...observation(),windowRef:'foreign-window'}}});client.handle({computerHost:{version:1,kind:'response',id:request.id,operation:'discover',result:discovery()}});client.handle({computerHost:{version:1,kind:'response',id:request.id,operation:'observe',result:observation(),privatePath:'C:\\private'}});client.handle({computerHost:{version:1,kind:'response',id:request.id,operation:'observe',result:observation()}});assert.equal((await running).windowRef,'window-1');}finally{client.close();}
});
test('four-request capacity is bounded and timeout sends cancellation without a later success or raw private error',async()=>{
 const sent:any[]=[],client=createWindowsComputerClient(message=>sent.push(message),{timeoutMs:15});try{const calls=Array.from({length:4},()=>client.services.discover(scope).catch(error=>error.message));await assert.rejects(client.services.discover(scope),/capacity/);assert.deepEqual(await Promise.all(calls),Array(4).fill('computer_timeout'));assert.equal(sent.filter(message=>message.computerHost.kind==='cancel').length,4);}finally{client.close();}
 const replies:any[]=[],server=createWindowsComputerServer({discover:async()=>{throw Error('PRIVATE token/path');},observe:async()=>observation()},message=>replies.push(message));server.handle({computerHost:{version:1,kind:'request',id:randomUUID(),operation:'discover',input:scope}});await tick();assert.equal(replies[0].computerHost.error,'computer_native_unavailable');assert(!JSON.stringify(replies).includes('PRIVATE'));server.close();
});
test('server cancellation/close reaches the real read signal and duplicate requests never dispatch again',async()=>{
 let signal:AbortSignal|undefined,release!:(value:ReturnType<typeof discovery>)=>void,calls=0;const sent:any[]=[],server=createWindowsComputerServer({discover:async(_input,value)=>{calls++;signal=value;return new Promise(resolve=>{release=resolve;});},observe:async()=>observation()},message=>sent.push(message));const id=randomUUID(),request={computerHost:{version:1,kind:'request',id,operation:'discover',input:scope}};server.handle(request);await tick();server.handle(request);assert.equal(sent[0].computerHost.error,'computer_capacity');server.handle({computerHost:{version:1,kind:'cancel',id}});assert(signal?.aborted);server.close();release(discovery());await tick();assert.equal(calls,1);assert.equal(sent.length,1);
});
test('empty or private error strings are failures, and client close cancels every outstanding read',async()=>{
 for(const error of ['', 'PRIVATE source path']){const sent:any[]=[],client=createWindowsComputerClient(message=>sent.push(message));try{const running=client.services.discover(scope),h=sent[0].computerHost;client.handle({computerHost:{version:1,kind:'response',id:h.id,operation:'discover',error}});await assert.rejects(running,/computer_native_unavailable/);}finally{client.close();}}
 const sent:any[]=[],client=createWindowsComputerClient(message=>sent.push(message)),running=client.services.discover(scope);const rejected=assert.rejects(running,/computer_native_unavailable/);client.close();await rejected;assert.equal(sent.at(-1).computerHost.kind,'cancel');
});
