import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {randomUUID} from 'node:crypto';
import {VelaToolWorkflows,type VelaToolOwner} from '../src/vela-tool-workflows.mts';import {toolDescriptor,derivedToolCatalog,exactToolArguments} from '../src/vela-tool-registry.mts';
function fixture(){const db=new DatabaseSync(':memory:');let allowed=true,now=Date.now(),calls=0,fail=false;
 const atomic=<T,>(work:()=>T):T=>{if(fail)throw Error('synthetic storage denied');if(db.isTransaction)return work();db.exec('BEGIN IMMEDIATE');try{const result=work();db.exec('COMMIT');return result;}catch(e){db.exec('ROLLBACK');throw e;}};atomic(()=>VelaToolWorkflows.migrate(db));
 const host={db,atomic,allowed:()=>allowed,now:()=>now};let journal=new VelaToolWorkflows(host);
 const owner:VelaToolOwner={descriptor:toolDescriptor({id:'application.count',family:'application',label:'Read count',description:'Synthetic owned counter',availability:'available',effect:'read',authorization:'host-policy',scope:'fixture',schema:{type:'object',additionalProperties:false,properties:{},required:[]},owner:'synthetic-owner'}),parse:v=>exactToolArguments(v,[]),invoke:()=>{calls++;return {state:'observed',output:{count:7},verification:{kind:'owner-observed',evidenceRefs:['synthetic-observation']}};}};
 const binding={requestId:randomUUID(),conversationId:randomUUID(),inputMessageId:randomUUID(),inputDigest:'input',scopeDigest:'scope',pinsDigest:'pins',contextDigest:'context'},catalog=derivedToolCatalog('scope',[owner]);
 const open=()=>journal.open(binding,catalog,[owner]),port=open(),input=()=>({catalogDigest:catalog.digest,capabilityId:owner.descriptor.id,schemaDigest:owner.descriptor.schemaDigest,invocationId:randomUUID(),argumentsJson:'{}'});
 const discovered=()=>port.discovered({executionId:randomUUID(),callId:randomUUID(),catalogDigest:catalog.digest,schemas:[{id:owner.descriptor.id,schemaDigest:owner.descriptor.schemaDigest}]});
 return {db,port,input,discovered,owner,catalog,binding,open,get journal(){return journal;},get calls(){return calls;},set allowed(v:boolean){allowed=v;},set fail(v:boolean){fail=v;},advance(ms:number){now+=ms;},reopen(){journal=new VelaToolWorkflows(host);return open();},close(){journal.dispose();db.close();}};
}
test('fetched source schema and once claim precede actual owner invocation; exact duplicates reuse canonical result',async()=>{const f=fixture();try{const i=f.input();await assert.rejects(f.port.invoke(i,new AbortController().signal),/not_discovered/);assert.equal(f.calls,0);f.discovered();const result=await f.port.invoke(i,new AbortController().signal);assert.equal(result.state,'observed');assert.deepEqual(JSON.parse(result.outputJson),{count:7});assert.equal(f.calls,1);assert.deepEqual(await f.port.invoke(i,new AbortController().signal),result);await assert.rejects(f.port.invoke({...i,argumentsJson:'{ }'},new AbortController().signal),/conflict/);assert.equal(f.calls,1);}finally{f.close();}});
test('scope revocation, storage denial and exhausted durable budgets fence effects',async()=>{const f=fixture();try{f.discovered();f.allowed=false;await assert.rejects(f.port.invoke(f.input(),new AbortController().signal),/scope_changed/);f.allowed=true;f.fail=true;await assert.rejects(f.port.invoke(f.input(),new AbortController().signal),/storage/);f.fail=false;assert.equal(f.calls,0);f.port.budget.providerRequests=13;assert.throws(()=>f.port.validate(),/budget_exhausted/);f.port.budget.providerRequests=0;f.advance(90001);assert.throws(()=>f.port.validate(),/budget_exhausted/);}finally{f.close();}});
test('durable dispatched uncertainty is not replayed after restart and schema proofs survive',async()=>{const f=fixture();try{f.discovered();const i=f.input();f.db.prepare("INSERT INTO vela_tool_invocations VALUES(?,?,?,'dispatching',NULL)").run(f.port.workflowId,i.invocationId,(await import('node:crypto')).createHash('sha256').update(JSON.stringify(i)).digest('hex'));const reopened=f.reopen(),receipt=await reopened.invoke(i,new AbortController().signal);assert.equal(receipt.state,'unknown');assert.equal(f.calls,0);assert.equal(receipt.verification.kind,'unverified');}finally{f.close();}});
test('catalog unavailability and discovery failure stay distinct; provider reports cannot become owner verification',async()=>{for(const availability of ['unavailable','unknown'] as const){const f=fixture();try{f.owner.descriptor.availability=availability;const catalog=derivedToolCatalog('scope',[f.owner]),binding={...f.binding,requestId:randomUUID()},port=f.journal.open(binding,catalog,[f.owner]);port.discovered({executionId:randomUUID(),callId:randomUUID(),catalogDigest:catalog.digest,schemas:[{id:f.owner.descriptor.id,schemaDigest:f.owner.descriptor.schemaDigest}]});const receipt=await port.invoke({...f.input(),catalogDigest:catalog.digest},new AbortController().signal);assert.equal(receipt.state,availability==='unknown'?'discovery-failed':'unavailable');assert.equal(f.calls,0);port.checkpoint('verified');assert.equal(f.journal.stateForRequest(binding.requestId)!.phase,'partial');}finally{f.close();}}});
test('delegated provider admission shares the original durable request budget without resetting the live primary port',()=>{const f=fixture();try{f.port.budget.providerRequests=11;f.port.validate();f.journal.admitChildProviderRequest(f.port.workflowId);assert.equal(f.port.budget.providerRequests,12);f.port.validate();assert.throws(()=>f.journal.admitChildProviderRequest(f.port.workflowId),/budget_exhausted/);assert.equal(f.reopen().budget.providerRequests,12);assert.equal(f.journal.stateForRequest(f.binding.requestId)!.budget.providerRequests,12);assert.equal(f.calls,0);}finally{f.close();}});
