import test from 'node:test';import assert from 'node:assert/strict';
import {readWeatherData,validWeatherData,validateWeatherData,unavailableWeatherData,type WeatherData} from '../src/weather-data.mts';
import type {WeatherQuery,WeatherMetric} from '../src/weather-tool.mts';
const HOUR=3600000,now=Date.parse('2026-11-04T10:15:00Z'),forecast='https://api.weather.gov/gridpoints/BTV/100,30/forecast/hourly';
const metrics:WeatherMetric[]=['temperature','humidity','conditions','precipitation','wind'];
const query=(patch:Partial<WeatherQuery>={}):WeatherQuery=>({startDate:null,endDate:null,period:'current',metrics:[...metrics],aggregation:'current',...patch});
const period=(time:number,index=0,patch:Record<string,unknown>={})=>({startTime:new Date(time).toISOString(),endTime:new Date(time+HOUR).toISOString(),temperature:60+index,temperatureUnit:'F',relativeHumidity:{unitCode:'wmoUnit:percent',value:55},probabilityOfPrecipitation:{unitCode:'wmoUnit:percent',value:30},shortForecast:'Clear',windSpeed:'5 mph',windDirection:'W',...patch});
const hours=(start:string,count:number,patch:(i:number)=>Record<string,unknown>=()=>({}))=>Array.from({length:count},(_,i)=>period(Date.parse(start)+i*HOUR,i,patch(i)));
function fixture(rows:unknown[]=hours('2026-11-04T10:00:00Z',48),zone='UTC',clock=now){
 const urls:string[]=[],observations:number[]=[];let allowed=true,locations=0,latitude=43.45827,locationOffset=0,forecastUrl=forecast,afterPoint=false,afterForecast=false;
 const options={now:()=>new Date(clock),authorize:()=>{if(!allowed)throw Error('PRIVATE_DENIAL_DETAILS');},locate:async(input:{requestedAtMs:number})=>{locations++;observations.push(input.requestedAtMs);return {latitude,longitude:-72.38753,observedAtMs:input.requestedAtMs+locationOffset,source:'wifi' as const};},fetch:async(url:Parameters<typeof fetch>[0],init?:RequestInit)=>{urls.push(String(url));assert.equal(init?.redirect,'error');assert(String(url).startsWith('https://api.weather.gov/'));if(String(url).includes('/points/')){if(afterPoint)allowed=false;return Response.json({properties:{timeZone:zone,forecastHourly:forecastUrl}});}if(afterForecast)allowed=false;return Response.json({properties:{updateTime:new Date(clock-HOUR).toISOString(),periods:rows}});}};
 return {options,urls,observations,get locations(){return locations;},deny:()=>{allowed=false;},move:(value:number)=>{latitude=value;},stale:()=>{locationOffset=-1;},badUrl:(value:string)=>{forecastUrl=value;},revokeAfterPoint:()=>{afterPoint=true;},revokeAfterForecast:()=>{afterForecast=true;}};
}
const read=(f:ReturnType<typeof fixture>,q=query())=>readWeatherData(q,new AbortController().signal,f.options);
test('current forecast returns structured requested metrics, approximate NWS-only egress and no coordinate/grid URL output',async()=>{
 const f=fixture(),data=await read(f);assert.equal(data.status,'complete');assert.equal(data.source.product,'hourly-forecast');assert.equal(data.current?.values.temperature?.mean,60);assert.equal(data.current?.values.humidity?.mean,55);assert.equal(data.current?.values.precipitation?.mean,null);assert.equal(data.units.precipitation,'hourly-probability-percent');assert.equal(data.current?.values.wind?.mean,5);assert.deepEqual(data.current?.values.wind?.directions,['W']);assert.deepEqual(f.urls,['https://api.weather.gov/points/43.46,-72.39',forecast]);assert.deepEqual(f.observations,[now]);const encoded=JSON.stringify(data);assert(!/latitude|longitude|43\.45827|72\.38753|gridpoints|\/points\//u.test(encoded));assert(encoded.length<8192);assert(validWeatherData(data));
});
test('every lookup requests fresh location and follows a moved position rather than caching coordinates',async()=>{const f=fixture();await read(f);f.move(44.551);await read(f);assert.equal(f.locations,2);assert.deepEqual(f.urls.filter(url=>url.includes('/points/')),['https://api.weather.gov/points/43.46,-72.39','https://api.weather.gov/points/44.55,-72.39']);});
test('stale fix and current denial cannot send a point to NWS or disclose private error text',async()=>{const f=fixture();f.stale();const stale=await read(f);assert.equal(stale.errorCode,'location_stale_fix');assert.equal(f.urls.length,0);const denied=fixture();denied.deny();const result=await read(denied);assert.equal(result.errorCode,'weather_permission_unavailable');assert.equal(denied.locations,0);assert.equal(denied.urls.length,0);assert(!JSON.stringify(result).includes('PRIVATE_DENIAL_DETAILS'));});
test('current purpose revocation is checked after each awaited NWS stage before further fetch or data release',async()=>{for(const after of ['point','forecast']){const f=fixture();if(after==='point')f.revokeAfterPoint();else f.revokeAfterForecast();const result=await read(f);assert.equal(result.status,'unavailable');assert.equal(result.errorCode,'weather_permission_unavailable');assert.equal(result.current,null);assert.equal(result.days.length,0);assert.equal(f.urls.length,after==='point'?1:2);}});
test('untrusted forecast destinations are rejected before second fetch',async()=>{for(const url of ['https://example.invalid/forecast/hourly','https://api.weather.gov.evil.invalid/gridpoints/BTV/100,30/forecast/hourly','http://api.weather.gov/gridpoints/BTV/100,30/forecast/hourly',forecast+'?extra=true','https://user:pass@api.weather.gov/gridpoints/BTV/100,30/forecast/hourly']){const f=fixture();f.badUrl(url);const result=await read(f);assert.equal(result.status,'unavailable');assert.equal(f.urls.length,1);assert(!JSON.stringify(result).includes(url));}});
test('a complete seven-day hourly series permits weighted temperature/humidity means with explicit units',async()=>{const f=fixture(hours('2026-11-05T00:00:00Z',168,()=>({temperature:20,temperatureUnit:'C'}))),data=await read(f,query({startDate:'2026-11-05',endDate:'2026-11-11',period:null,aggregation:'mean',metrics:['temperature','humidity']}));assert.equal(data.status,'complete');assert.equal(data.days.length,7);assert.equal(data.coverage.requestedHours,168);assert.equal(data.coverage.availableHours,168);assert.equal(data.aggregate?.values.temperature?.mean,68);assert.equal(data.aggregate?.values.humidity?.mean,55);assert.equal(data.units.temperature,'degF');});
test('a missing hour makes the requested full mean unavailable while ranges remain explicitly available-hour ranges',async()=>{const rows=hours('2026-11-05T00:00:00Z',24);rows.splice(12,1);const data=await read(fixture(rows),query({period:'tomorrow',aggregation:'mean',metrics:['temperature']}));assert.equal(data.status,'partial');assert.equal(data.coverage.requestedHours,24);assert.equal(data.coverage.availableHours,23);assert.equal(data.aggregate?.values.temperature?.mean,null);assert.equal(data.aggregate?.values.temperature?.availableMin,60);assert.equal(data.aggregate?.values.temperature?.availableMax,83);});
test('missing humidity is separate from complete temperature coverage and cannot become a fabricated mean',async()=>{const rows=hours('2026-11-05T00:00:00Z',24,i=>i===8?{relativeHumidity:{unitCode:'wmoUnit:percent',value:null}}:{}),data=await read(fixture(rows),query({period:'tomorrow',aggregation:'daily',metrics:['temperature','humidity']}));assert.equal(data.status,'partial');assert.deepEqual(data.coverage.missingMetrics,['humidity']);assert.equal(data.days[0].values.humidity?.mean,null);assert.equal(data.days[0].values.humidity?.hours,23);assert.equal(data.days[0].values.temperature?.complete,true);});
test('relative weekdays use next occurrence including seven days when today matches; next week is Monday through Sunday',async()=>{const expected={'next-monday':'2026-11-09','next-tuesday':'2026-11-10','next-wednesday':'2026-11-11','next-thursday':'2026-11-05','next-friday':'2026-11-06','next-saturday':'2026-11-07','next-sunday':'2026-11-08'};for(const [name,day] of Object.entries(expected)){const data=await read(fixture(),query({period:name as WeatherQuery['period'],aggregation:'daily',metrics:['humidity']}));assert.equal(data.requested.resolvedStartDate,day);assert.equal(data.requested.resolvedEndDate,day);}const week=await read(fixture(hours('2026-11-04T10:00:00Z',168)),query({period:'next-week',aggregation:'mean',metrics:['temperature']}));assert.equal(week.requested.resolvedStartDate,'2026-11-09');assert.equal(week.requested.resolvedEndDate,'2026-11-15');assert.equal(week.status,'partial');assert.equal(week.aggregate?.values.temperature?.mean,null);});
test('out-of-horizon dates and absent current hour do not silently substitute another forecast period',async()=>{const future=await read(fixture(),query({startDate:'2026-12-01',endDate:'2026-12-01',period:null,aggregation:'daily'}));assert.equal(future.status,'out-of-horizon');assert.equal(future.coverage.availableHours,0);assert(future.days.every(day=>day.values.temperature?.mean===null));const current=await read(fixture(hours('2026-11-04T11:00:00Z',2)));assert.equal(current.status,'out-of-horizon');assert.equal(current.current,null);});
test('local civil-day coverage uses actual DST durations rather than assuming 24 hours',async()=>{for(const [clock,day,start,length] of [[Date.parse('2026-10-31T12:00:00Z'),'2026-11-01','2026-11-01T04:00:00Z',25],[Date.parse('2026-03-07T12:00:00Z'),'2026-03-08','2026-03-08T05:00:00Z',23]] as const){const data=await read(fixture(hours(start,length,()=>({temperature:50})),'America/New_York',clock),query({startDate:day,endDate:day,period:null,aggregation:'mean',metrics:['temperature']}));assert.equal(data.status,'complete');assert.equal(data.coverage.requestedHours,length);assert.equal(data.aggregate?.values.temperature?.mean,50);}});
test('night and morning periods disclose bounded local intervals; wind ranges and hourly precipitation are not invented averages',async()=>{const rows=hours('2026-11-04T10:00:00Z',48,()=>({windSpeed:'5 to 10 mph'}));const night=await read(fixture(rows),query({period:'tonight',aggregation:'mean',metrics:['wind','precipitation']}));assert.equal(night.coverage.requestedHours,12);assert.equal(night.aggregate?.values.wind?.availableMin,5);assert.equal(night.aggregate?.values.wind?.availableMax,10);assert.equal(night.aggregate?.values.wind?.mean,null);assert.equal(night.aggregate?.values.precipitation?.mean,null);const morning=await read(fixture(rows),query({period:'tomorrow-morning',aggregation:'daily'}));assert.equal(morning.coverage.requestedHours,6);});
test('overlapping hourly rows cannot falsely establish full coverage',async()=>{const rows=hours('2026-11-05T00:00:00Z',24);rows.push(rows[3]);const result=await read(fixture(rows),query({period:'tomorrow',aggregation:'mean'}));assert.equal(result.status,'unavailable');assert.equal(result.errorCode,'weather_source_invalid');});
test('seven-day all-metric summaries remain at most8KiB and disclose bounded conditions summaries',async()=>{const rows=hours('2026-11-05T00:00:00Z',168,i=>({shortForecast:(i%2?'☀️':'🌧️').repeat(30)})),result=await read(fixture(rows),query({startDate:'2026-11-05',endDate:'2026-11-11',period:null,aggregation:'mean'}));assert.equal(result.status,'complete');assert.equal(result.days.length,7);assert(Buffer.byteLength(JSON.stringify(result))<=8192);assert(result.days[0].values.conditions?.truncated);assert(validWeatherData(result));});
test('strict query failures perform no authorization, location or network work',async()=>{for(const bad of [{...query(),latitude:1},query({metrics:['humidity','humidity']}),query({startDate:'2026-02-30',endDate:'2026-03-01',period:null,aggregation:'daily'}),query({startDate:'2026-11-01',endDate:'2026-11-08',period:null,aggregation:'daily'}),query({period:'today',aggregation:'current'})]){const f=fixture();await assert.rejects(readWeatherData(bad as WeatherQuery,new AbortController().signal,f.options),/weather_query_invalid/);assert.equal(f.locations,0);assert.equal(f.urls.length,0);}});
test('closed runtime egress validation rejects coordinates, getters, excess bytes and invented partial means',async()=>{const data=await read(fixture());for(const bad of [{...data,latitude:43},{...data,source:{...data.source,gridUrl:forecast}},{...data,current:false},{...data,current:{...data.current!,values:{...data.current!.values,humidity:{...data.current!.values.humidity!,complete:false,mean:55}}}}])assert.equal(validWeatherData(bad),false);let invoked=false;const bad={...data,source:{...data.source}};Object.defineProperty(bad.source,'name',{enumerable:true,get(){invoked=true;return 'National Weather Service';}});assert.equal(validWeatherData(bad),false);assert.equal(invoked,false);assert.equal(validWeatherData({...data,source:{...data.source,name:'x'.repeat(9000)}}),false);assert.equal(validateWeatherData(data),data);});
test('unavailable factory has no fabricated fetch timestamp, unsafe reason text or location details',()=>{for(const [reason,expected] of [['missing-host','location_native_unavailable'],['purpose-deny','weather_permission_denied'],['cancel','weather_cancelled'],['inprogress','weather_in_progress'],['PRIVATE_URL_OR_COORDINATE','weather_source_unavailable'],['__proto__','weather_source_unavailable']]){const data=unavailableWeatherData(query(),reason,now);assert(validWeatherData(data));assert.equal(data.source.fetchedAt,null);assert.equal(data.source.locationObservedAt,null);assert.equal(data.errorCode,expected);assert(!JSON.stringify(data).includes('PRIVATE_URL_OR_COORDINATE'));}});
test('runtime validation rejects a one-day value relabeled as a complete week and conflicting coverage flags',async()=>{const data=await read(fixture(hours('2026-11-05T00:00:00Z',24)),query({period:'tomorrow',aggregation:'mean',metrics:['temperature']}));assert.equal(data.status,'complete');const fake=structuredClone(data);fake.requested.period='next-week';fake.requested.resolvedStartDate='2026-11-09';fake.requested.resolvedEndDate='2026-11-15';fake.coverage.requestedDates=Array.from({length:7},(_,i)=>'2026-11-'+String(9+i).padStart(2,'0'));assert.equal(validWeatherData(fake),false);const conflict=structuredClone(data);conflict.status='partial';assert.equal(validWeatherData(conflict),false);});
test('oversized NWS bodies and aborted fresh-location work are bounded without another request',async()=>{const f=fixture();let calls=0;const result=await readWeatherData(query(),new AbortController().signal,{...f.options,fetch:async()=>{calls++;return new Response(new Uint8Array(1024*1024+1));}});assert.equal(result.errorCode,'weather_source_capacity');assert.equal(calls,1);const cancel=new AbortController();let ready!:()=>void;const began=new Promise<void>(resolve=>{ready=resolve;});const pending=readWeatherData(query(),cancel.signal,{...f.options,locate:async()=>{ready();return new Promise(()=>{});}});await began;cancel.abort(Error('OWNED_CANCEL'));await assert.rejects(pending,/OWNED_CANCEL/);assert.equal(f.urls.length,0);});
