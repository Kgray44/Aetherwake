import test from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {createDocumentTextClient,createDocumentTextServer,validDocumentTextInput,validDocumentTextResult,type DocumentTextInput,type DocumentTextResult} from '../src/document-text-host.mts';
const input=():DocumentTextInput=>({jobId:randomUUID(),resourceId:randomUUID(),expectedVersion:1,sourceRevision:'a'.repeat(64),format:'pdf',maxTextBytes:1000});
const result=(i:DocumentTextInput):DocumentTextResult=>({jobId:i.jobId,sourceRevision:i.sourceRevision,state:'complete',text:'Synthetic extracted text',textDigest:createHash('sha256').update('Synthetic extracted text').digest('hex'),coverage:'extractable-text-all-pages',units:2,omittedImages:null,unsupportedParts:['Images not read']});
test('document protocol rejects path authority, incorrect source/hash/coverage and unbounded output',()=>{const i=input();assert.ok(validDocumentTextInput(i));assert.equal(validDocumentTextInput({...i,path:'C:\\private'}),false);assert.equal(validDocumentTextInput({...i,maxTextBytes:12001}),false);
  for(const mutation of [{jobId:randomUUID()},{sourceRevision:'b'.repeat(64)},{text:'other'},{units:null},{coverage:'whole-document-text'},{text:'x'.repeat(1001)},{unsupportedParts:['x'.repeat(121)]}])assert.equal(validDocumentTextResult({...result(i),...mutation},i),false);});
test('private client ignores malformed/late results, cancels exact jobs and admits a fresh request afterward',async()=>{const wires:any[]=[],client=createDocumentTextClient(wire=>wires.push(wire)),i=input(),abort=new AbortController(),pending=client.services.extract(i,abort.signal);pending.catch(()=>{});const request=wires[0].documentHost;
  client.handle({documentHost:{version:1,kind:'response',id:request.id,result:{...result(i),jobId:'wrong'}}});abort.abort();await assert.rejects(pending,/cancelled/);assert.equal(wires[1].documentHost.kind,'cancel');assert.equal(wires[1].documentHost.jobId,i.jobId);
  const fresh=input(),next=client.services.extract(fresh,new AbortController().signal),h=wires.at(-1).documentHost;client.handle({documentHost:{version:1,kind:'response',id:request.id,result:result(i)}});client.handle({documentHost:{version:1,kind:'response',id:h.id,result:result(fresh)}});assert.equal((await next).state,'complete');client.close();});
test('server bounds concurrent parsing, cancels only matching job ownership and exposes no private error',async()=>{const replies:any[]=[];let signal:AbortSignal|undefined,release:(()=>void)|undefined;const i=input(),request={documentHost:{version:1,kind:'request',id:randomUUID(),input:i}},server=createDocumentTextServer({extract:async(_input,s)=>{signal=s;await new Promise<void>(resolve=>{release=resolve;});throw Error('PRIVATE DOCUMENT BODY OR PATH');}},wire=>replies.push(wire));
  server.handle(request);await Promise.resolve();server.handle({documentHost:{...request.documentHost,id:randomUUID(),input:input()}});assert.equal(replies[0].documentHost.error,'document_extraction_unavailable');
  server.handle({documentHost:{version:1,kind:'cancel',id:request.documentHost.id,jobId:randomUUID()}});assert.equal(signal?.aborted,false);server.handle({documentHost:{version:1,kind:'cancel',id:request.documentHost.id,jobId:i.jobId}});assert.equal(signal?.aborted,true);release?.();await new Promise(resolve=>setImmediate(resolve));assert.doesNotMatch(JSON.stringify(replies),/PRIVATE/);server.close();});
