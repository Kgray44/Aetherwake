import test from 'node:test';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {prepareResponsesTurn,ResponsesTransport} from '../responses.mts';
import type {TurnInput} from '../contracts.mts';
const definition={type:'function' as const,name:'synthetic_read',description:'Source-owned synthetic read.',parameters:{type:'object',properties:{},required:[],additionalProperties:false},strict:true as const};
const tool={definition,schemaDigest:createHash('sha256').update(JSON.stringify(definition)).digest('hex'),authorizationRef:'synthetic-native-review'};
const input=():TurnInput=>({executionId:'execution-synthetic',requestId:'request-synthetic',configurationId:'vela-primary',providerId:'openai-api-vela',assistant:'vela',model:'gpt-6-luna',instructions:'Synthetic native instructions.',messages:[{role:'user',content:'Synthetic request'}],contextDigest:'a'.repeat(64),api:{configurationVersion:1,instructionVersion:'synthetic-v1',maxOutputTokens:2048,tools:[tool]}});
test('parallel tool proposals remain false for legacy requests and exact native opt-in changes the reviewed body binding',()=>{const legacy=prepareResponsesTurn(input()),parallel=prepareResponsesTurn({...input(),api:{...input().api!,parallelToolCalls:true}});assert.equal(JSON.parse(legacy.body).parallel_tool_calls,false);assert.equal(legacy.review.api?.parallelToolCalls,undefined);assert.equal(JSON.parse(parallel.body).parallel_tool_calls,true);assert.equal(parallel.review.api?.parallelToolCalls,true);assert.notEqual(legacy.review.bodyDigest,parallel.review.bodyDigest);assert.deepEqual(legacy.review.api?.tools,parallel.review.api?.tools);});
test('invalid or tool-less parallel opt-in never widens ordinary or ChatGPT requests',()=>{for(const value of [false,'true',1])assert.throws(()=>prepareResponsesTurn({...input(),api:{...input().api!,parallelToolCalls:value}as any}),/invalid_api_tools/);assert.throws(()=>prepareResponsesTurn({...input(),api:{...input().api!,tools:[],parallelToolCalls:true}}),/invalid_api_tools/);assert.throws(()=>prepareResponsesTurn({...input(),providerId:'chatgpt-plan-responses',assistant:'ordinary',api:{...input().api!,parallelToolCalls:true}}),/invalid_api_turn/);});
test('an approval for the legacy body cannot dispatch the opt-in body',async()=>{const expected=prepareResponsesTurn(input()).review;let posts=0;const transport=new ResponsesTransport({fetch:async()=>{posts++;throw Error('Unexpected dispatch');},onEvent(){},native:{authorize:async review=>{assert.equal(review.bodyDigest,expected.bodyDigest);},resolveCredential:async()=>{throw Error('No credential needed');},resolveCatalog:async()=>{throw Error('No catalog needed');},revalidate:async()=>{throw Error('No revalidation needed');}}});const result=await transport.turn({...input(),api:{...input().api!,parallelToolCalls:true}},new AbortController().signal);assert.equal(posts,0);assert.equal(result.dispatched,false);assert.notEqual(result.outcome,'completed');});
const sha=(value:string)=>createHash('sha256').update(value).digest('hex');
function continued(){const items=[{type:'function_call' as const,id:'source-item',call_id:'source-call',name:definition.name,arguments:'{}',status:'completed' as const}],sourceContext='a'.repeat(64),nextContext='b'.repeat(64),certificate={priorContextDigest:sourceContext,nextContextDigest:nextContext,ownerReceiptId:'native-owner-receipt',sourceProofDigest:'c'.repeat(64)};return {...input(),contextDigest:nextContext,messages:[{role:'user' as const,content:'Original request with a native-approved source revision.'}],api:{...input().api!,continuation:{sourceExecutionId:'source-execution',responseId:'source-response',configurationVersion:1,contextDigest:sourceContext,sourceOutcome:'completed' as const,itemsDigest:sha(JSON.stringify(items)),items,toolOutputs:[{callId:'source-call',name:definition.name,argumentsDigest:sha('{}'),output:'{"observed":true}',receiptId:'api-tool-receipt'}],contextTransition:certificate}}};}
test('reviewed context transition binds a fresh turn while leaving source context and provider items untouched',()=>{const turn=continued(),prepared=prepareResponsesTurn(turn);assert.equal(prepared.review.contextDigest,'b'.repeat(64));assert.equal(prepared.review.api!.continuation!.contextDigest,'a'.repeat(64));assert.deepEqual(prepared.review.api!.continuation!.contextTransition,turn.api.continuation.contextTransition);assert(!prepared.body.includes('sourceProofDigest'));assert.equal(JSON.parse(prepared.body).input[1].id,'source-item');assert.equal(turn.api.continuation.contextDigest,'a'.repeat(64));});
test('context drift without an exact source/next certificate, or with malformed private proof, fails before dispatch',()=>{for(const kind of ['missing','prior','next','proof','owner','same']as const){const turn=continued();if(kind==='missing')delete(turn.api.continuation as any).contextTransition;else if(kind==='same')turn.contextDigest='a'.repeat(64);else if(kind==='prior')turn.api.continuation.contextTransition.priorContextDigest='f'.repeat(64);else if(kind==='next')turn.api.continuation.contextTransition.nextContextDigest='f'.repeat(64);else if(kind==='proof')turn.api.continuation.contextTransition.sourceProofDigest='invalid';else turn.api.continuation.contextTransition.ownerReceiptId='C:/private/path';assert.throws(()=>prepareResponsesTurn(turn),/context_transition/);}});
