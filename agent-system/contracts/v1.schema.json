{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aetherwake Engineering Control-Plane Contracts v1",
  "description": "Task-centric engineering records. NOT Vela MissionService product runtime state. Never store secrets or sensitive telemetry in public Git.",
  "oneOf": [
    {
      "$ref": "#/$defs/Task"
    },
    {
      "$ref": "#/$defs/Attempt"
    },
    {
      "$ref": "#/$defs/Evidence"
    },
    {
      "$ref": "#/$defs/Telemetry"
    },
    {
      "$ref": "#/$defs/ContextSnapshot"
    },
    {
      "$ref": "#/$defs/VerificationProfile"
    }
  ],
  "$defs": {
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git",
            "requirement",
            "document",
            "artifact",
            "issue",
            "pull_request",
            "url"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "repository",
        "revision",
        "title",
        "objective",
        "classification",
        "prerequisites",
        "acceptance",
        "state"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "task"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "classification": {
          "type": "object",
          "required": [
            "primary"
          ],
          "properties": {
            "primary": {
              "enum": [
                "bug",
                "feature",
                "visual",
                "backend",
                "performance",
                "security",
                "research",
                "documentation",
                "maintenance",
                "integration"
              ]
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "prerequisites": {
          "type": "object",
          "required": [
            "task_ids",
            "capabilities"
          ],
          "properties": {
            "task_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "merged_task_ids": {
              "description": "Subset of task_ids that require the current accepted candidate to be verified on main.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "deliverables": {
          "description": "Planned outcomes to produce for this Task. Review and artifact custody are recorded separately.",
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "uri"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "git",
                  "requirement",
                  "document",
                  "artifact",
                  "issue",
                  "pull_request",
                  "url"
                ]
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string"
              }
            }
          }
        },
        "acceptance": {
          "type": "object",
          "required": [
            "profile_id",
            "criteria"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authority": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "uri"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "git",
                          "requirement",
                          "document",
                          "artifact",
                          "issue",
                          "pull_request",
                          "url"
                        ]
                      },
                      "uri": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "state": {
          "enum": [
            "proposed",
            "ready",
            "running",
            "verifying",
            "blocked",
            "failed",
            "accepted",
            "cancelled",
            "superseded"
          ]
        },
        "owner_acceptance": {
          "enum": [
            "not_reviewed",
            "accepted",
            "rejected",
            "not_required"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "uri"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "git",
                  "requirement",
                  "document",
                  "artifact",
                  "issue",
                  "pull_request",
                  "url"
                ]
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string"
              }
            }
          }
        },
        "superseded_by": {
          "type": "string"
        }
      }
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "repository",
        "revision",
        "task_id",
        "attempt_number",
        "state",
        "started_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "attempt"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "verifying",
            "succeeded",
            "failed",
            "blocked",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "failure_category": {
          "enum": [
            "none",
            "requirements",
            "implementation",
            "test",
            "integration",
            "environment",
            "visual_mismatch",
            "authorization",
            "unknown"
          ]
        },
        "failure_diagnosis": {
          "type": "string"
        },
        "changed_assumption": {
          "type": "string"
        }
      }
    },
    "MatchedBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "artifact_sha256",
        "provider",
        "model",
        "standard",
        "compact"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,79}/)*[A-Za-z0-9_-][A-Za-z0-9_.-]{0,79}$",
          "maxLength": 240
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "standard": {
          "$ref": "#/$defs/MatchedBenchmarkArm"
        },
        "compact": {
          "$ref": "#/$defs/MatchedBenchmarkArm"
        }
      }
    },
    "MatchedBenchmarkArm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "total_tokens",
        "commands",
        "turn_ms"
      ],
      "properties": {
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turn_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "repository",
        "revision",
        "task_id",
        "attempt_id",
        "criterion_id",
        "kind",
        "result",
        "observed_at",
        "artifact"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "evidence"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "test",
            "visual",
            "motion",
            "benchmark",
            "security",
            "review",
            "build",
            "other"
          ]
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "not_run"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "matched_benchmark": { "$ref": "#/$defs/MatchedBenchmark" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "uri"
          ],
          "properties": {
            "kind": {
              "enum": [
                "git",
                "requirement",
                "document",
                "artifact",
                "issue",
                "pull_request",
                "url"
              ]
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "Telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "repository",
        "revision",
        "task_id",
        "attempt_id",
        "phase",
        "observed_at",
        "measurements"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "telemetry"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "context",
            "implementation",
            "verification",
            "integration",
            "review",
            "other"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "availability"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "availability": {
                "enum": [
                  "observed",
                  "estimated",
                  "unavailable"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "method": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ContextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "repository",
        "revision",
        "task_id",
        "generated_at",
        "requirements",
        "components",
        "freshness"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "context_snapshot"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "uri"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "git",
                  "requirement",
                  "document",
                  "artifact",
                  "issue",
                  "pull_request",
                  "url"
                ]
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string"
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "owner_ref"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "owner_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "uri"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "git",
                      "requirement",
                      "document",
                      "artifact",
                      "issue",
                      "pull_request",
                      "url"
                    ]
                  },
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unverified"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "VerificationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "repository",
        "revision",
        "profile_id",
        "task_classes",
        "checks"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "verification_profile"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "task_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "procedure",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "procedure": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "manual_approval": {
                "type": "boolean"
              }
            }
          }
        },
        "blocking_policy": {
          "enum": [
            "report_only",
            "enforce"
          ]
        }
      }
    }
  }
}
