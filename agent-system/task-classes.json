{
  "schema_version": 1,
  "contract": "agent-system/contracts/v1.schema.json",
  "policy": "Primary task class selects workflow; secondary classes and path-derived risks only ADD checks. Governance, authorization, Windows native-test admission, and owner acceptance always remain authoritative.",
  "classes": {
    "bug": {
      "skill": ".agents/skills/bug-fix/SKILL.md",
      "checks": [
        "reproduction",
        "regression-test",
        "focused-tests"
      ]
    },
    "feature": {
      "skill": ".agents/skills/feature/SKILL.md",
      "checks": [
        "end-to-end-outcome",
        "contract-tests",
        "focused-tests"
      ]
    },
    "visual": {
      "skill": ".agents/skills/visual/SKILL.md",
      "checks": [
        "rendered-frames",
        "motion-scenario",
        "visual-review",
        "focused-tests"
      ]
    },
    "backend": {
      "skill": ".agents/skills/backend/SKILL.md",
      "checks": [
        "interface-contract",
        "negative-paths",
        "integration-tests"
      ]
    },
    "performance": {
      "skill": ".agents/skills/performance/SKILL.md",
      "checks": [
        "measured-baseline",
        "before-after-comparison",
        "quality-parity"
      ]
    },
    "security": {
      "skill": ".agents/skills/security/SKILL.md",
      "checks": [
        "authorization-tests",
        "deny-paths",
        "security-review"
      ]
    },
    "research": {
      "skill": ".agents/skills/research/SKILL.md",
      "checks": [
        "reproducible-experiment",
        "evidence-based-decision"
      ]
    },
    "documentation": {
      "skill": ".agents/skills/documentation/SKILL.md",
      "checks": [
        "authority-audit",
        "cross-document-consistency"
      ]
    },
    "maintenance": {
      "skill": ".agents/skills/maintenance/SKILL.md",
      "checks": [
        "focused-tests",
        "behavior-preservation"
      ]
    },
    "integration": {
      "skill": ".agents/skills/integration/SKILL.md",
      "checks": [
        "integration-tests",
        "source-owner-review",
        "merge-readiness"
      ]
    }
  },
  "additive_risks": {
    "security": {
      "checks": [
        "authorization-tests",
        "deny-paths",
        "security-review"
      ]
    },
    "visual": {
      "checks": [
        "rendered-frames",
        "motion-scenario",
        "visual-review"
      ]
    },
    "performance": {
      "checks": [
        "measured-baseline",
        "before-after-comparison",
        "quality-parity"
      ]
    },
    "desktop": {
      "checks": [
        "native-test-admission",
        "native-evidence-if-authorized"
      ]
    },
    "backend": {
      "checks": [
        "interface-contract",
        "negative-paths",
        "integration-tests"
      ]
    },
    "gpu": {
      "checks": [
        "gpu-rendered-evidence",
        "measured-baseline",
        "quality-parity"
      ]
    }
  },
  "path_risks": [
    {
      "path_prefixes": [
        "src/security/",
        "src/auth/",
        "src/authorization/",
        "src/trust/",
        "src/permissions/"
      ],
      "risk": "security"
    },
    {
      "path_prefixes": [
        "src/rendering/",
        "src/visual/",
        "src/presence/",
        "src/motion/",
        "src/ui/"
      ],
      "risk": "visual"
    },
    {
      "path_prefixes": [
        "src/performance/",
        "src/resource/"
      ],
      "risk": "performance"
    },
    {
      "path_prefixes": [
        "desktop/",
        "src/desktop/",
        "src/native/"
      ],
      "risk": "desktop"
    },
    {
      "path_prefixes": [
        "prototypes/visual-experience/cinematic-v3/src/",
        "prototypes/visual-experience/cinematic-v3/public/"
      ],
      "risk": "visual"
    },
    {
      "path_prefixes": [
        "prototypes/visual-experience/cinematic-v3/src/",
        "prototypes/integrated-backend/src/resource-",
        "prototypes/integrated-backend/src/windows-gpu-"
      ],
      "risk": "performance"
    },
    {
      "path_prefixes": [
        "prototypes/integrated-backend/"
      ],
      "risk": "backend"
    },
    {
      "path_prefixes": [
        "prototypes/integrated-backend/src/",
        "prototypes/visual-experience/cinematic-v3/native/",
        "agent-system/observatory/sites/"
      ],
      "risk": "security"
    },
    {
      "path_prefixes": [
        "prototypes/visual-experience/cinematic-v3/native/",
        "prototypes/integrated-backend/src/desktop-",
        "prototypes/integrated-backend/src/windows-"
      ],
      "risk": "desktop"
    },
    {
      "path_prefixes": [
        "prototypes/visual-experience/cinematic-v3/src/presence",
        "prototypes/visual-experience/cinematic-v3/src/nebula",
        "prototypes/integrated-backend/src/mission-gpu-",
        "prototypes/integrated-backend/src/windows-gpu-",
        "prototypes/visual-experience/cinematic-v3/src/renderer",
        "prototypes/visual-experience/cinematic-v3/src/main.ts"
      ],
      "risk": "gpu"
    }
  ],
  "verification_targets": [
    {
      "id": "task-objectives",
      "paths": [
        "prototypes/integrated-backend/src/task-objectives.mts",
        "prototypes/task-product/service.mts"
      ],
      "cwd": "prototypes/integrated-backend",
      "tests": [
        "tests/task-objectives.test.mts",
        "tests/task-reference-targets.test.mts",
        "tests/task-objective-core.test.mts"
      ]
    },
    {
      "id": "task-reference-targets",
      "paths": [
        "prototypes/integrated-backend/src/task-reference-targets.mts"
      ],
      "cwd": "prototypes/integrated-backend",
      "tests": [
        "tests/task-reference-targets.test.mts"
      ]
    },
    {
      "id": "mission-resource-admission",
      "paths": [
        "prototypes/integrated-backend/src/mission-admission.mts",
        "prototypes/integrated-backend/src/resource-policy.mts"
      ],
      "cwd": "prototypes/integrated-backend",
      "tests": [
        "tests/resource-policy.test.mts",
        "tests/resource-telemetry.test.mts"
      ]
    },
    {
      "id": "engineering-context",
      "paths": [
        "scripts/agent/context.mjs",
        "scripts/agent/task-router.mjs"
      ],
      "cwd": ".",
      "tests": [
        "tests/agent-task-router.test.mjs",
        "tests/agent-phase-c.test.mjs"
      ]
    },
    {
      "id": "engineering-traces",
      "paths": [
        "scripts/agent/journal.mjs",
        "scripts/agent/record-journal.mjs",
        "scripts/agent/lifecycle.mjs",
        "scripts/agent/telemetry-export.mjs"
      ],
      "cwd": ".",
      "tests": [
        "tests/agent-journal.test.mjs",
        "tests/agent-phase-c.test.mjs"
      ]
    }
  ],
  "policy_revision": "2026-11-16.2",
  "universal_checks": [
    "governance-coverage",
    "source-owner-review",
    "affected-scope-review"
  ]
}
