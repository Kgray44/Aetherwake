{
  "schema_version": 1,
  "contract": "agent-system/contracts/v1.schema.json",
  "policy": "Primary task class selects workflow; secondary classes and path-derived risks only ADD checks. Governance, authorization, Windows native-test admission, and owner acceptance always remain authoritative.",
  "classes": {
    "bug": {
      "skill": ".agents/skills/bug-fix/SKILL.md",
      "checks": [
        "reproduction",
        "regression-test",
        "focused-tests"
      ]
    },
    "feature": {
      "skill": ".agents/skills/feature/SKILL.md",
      "checks": [
        "end-to-end-outcome",
        "contract-tests",
        "focused-tests"
      ]
    },
    "visual": {
      "skill": ".agents/skills/visual/SKILL.md",
      "checks": [
        "rendered-frames",
        "motion-scenario",
        "visual-review",
        "focused-tests"
      ]
    },
    "backend": {
      "skill": ".agents/skills/backend/SKILL.md",
      "checks": [
        "interface-contract",
        "negative-paths",
        "integration-tests"
      ]
    },
    "performance": {
      "skill": ".agents/skills/performance/SKILL.md",
      "checks": [
        "measured-baseline",
        "before-after-comparison",
        "quality-parity"
      ]
    },
    "security": {
      "skill": ".agents/skills/security/SKILL.md",
      "checks": [
        "authorization-tests",
        "deny-paths",
        "security-review"
      ]
    },
    "research": {
      "skill": ".agents/skills/research/SKILL.md",
      "checks": [
        "reproducible-experiment",
        "evidence-based-decision"
      ]
    },
    "documentation": {
      "skill": ".agents/skills/documentation/SKILL.md",
      "checks": [
        "authority-audit",
        "cross-document-consistency"
      ]
    },
    "maintenance": {
      "skill": ".agents/skills/maintenance/SKILL.md",
      "checks": [
        "focused-tests",
        "behavior-preservation"
      ]
    },
    "integration": {
      "skill": ".agents/skills/integration/SKILL.md",
      "checks": [
        "integration-tests",
        "source-owner-review",
        "merge-readiness"
      ]
    }
  },
  "additive_risks": {
    "security": {
      "checks": [
        "authorization-tests",
        "deny-paths",
        "security-review"
      ]
    },
    "visual": {
      "checks": [
        "rendered-frames",
        "motion-scenario",
        "visual-review"
      ]
    },
    "performance": {
      "checks": [
        "measured-baseline",
        "before-after-comparison",
        "quality-parity"
      ]
    },
    "desktop": {
      "checks": [
        "native-test-admission",
        "native-evidence-if-authorized"
      ]
    }
  },
  "path_risks": [
    {
      "path_prefixes": [
        "src/security/",
        "src/auth/",
        "src/authorization/",
        "src/trust/",
        "src/permissions/"
      ],
      "risk": "security"
    },
    {
      "path_prefixes": [
        "src/rendering/",
        "src/visual/",
        "src/presence/",
        "src/motion/",
        "src/ui/"
      ],
      "risk": "visual"
    },
    {
      "path_prefixes": [
        "src/performance/",
        "src/resource/"
      ],
      "risk": "performance"
    },
    {
      "path_prefixes": [
        "desktop/",
        "src/desktop/",
        "src/native/"
      ],
      "risk": "desktop"
    }
  ]
}
